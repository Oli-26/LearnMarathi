@page "/"
@using LearnMarathi.Services
@inject IStreakService Streak
@inject IReviewService Review
@inject IHardWordsService HardWords
@inject NavigationManager NavigationManager
@inject CommutePlayer Player
@implements IDisposable

<PageTitle>Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">
    @* Masthead *@
    <div style="padding:8px 24px 0;">
        <div class="eyebrow" style="font-size:11px;">@DateTime.Now.ToString("dddd · d MMMM")</div>
        <div style="display:flex;align-items:baseline;gap:12px;margin-top:14px;flex-wrap:wrap;">
            <span style="font-family:@Theme.Serif;font-size:40px;line-height:1;letter-spacing:-1px;color:@Theme.Cream;">Learn Marathi.</span>
            <span style="font-family:@Theme.Deva;font-size:24px;color:@Theme.Gold;">मराठी शिका</span>
        </div>
    </div>

    @* Today: the one-tap daily plan *@
    <div class="card anim-fade-up" style="margin:22px 16px 30px;padding:20px 20px 18px;">
        @if (!loaded)
        {
            <div class="skeleton" style="height:16px;width:40%;"></div>
            <div class="skeleton" style="height:40px;margin-top:14px;"></div>
            <div class="skeleton" style="height:50px;margin-top:16px;border-radius:100px;"></div>
        }
        else
        {
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <span class="eyebrow">Today</span>
                <span style="display:flex;align-items:center;gap:6px;font-family:@Theme.Mono;font-size:11px;color:@(streak?.ActiveToday == true ? Theme.Gold : Theme.Muted);">
                    <Icon Name="flame" Size="14" Color="@(streak?.ActiveToday == true ? Theme.Gold : Theme.Muted)" />
                    @(streak?.CurrentStreak ?? 0)-day streak
                </span>
            </div>

            <div style="display:flex;gap:22px;margin-top:14px;">
                @foreach (var (n, label, color) in new[] { (today.Due, "due", Theme.Cream), (today.New, "new", Theme.Cream), (hardCount, "hard", Theme.Gold) })
                {
                    <div>
                        <div style="font-family:@Theme.Serif;font-size:34px;line-height:1;color:@(n > 0 ? color : Theme.MutedDk);">@n</div>
                        <div class="eyebrow" style="margin-top:4px;">@label</div>
                    </div>
                }
                <div style="margin-left:auto;display:flex;gap:5px;align-items:flex-end;">
                    @foreach (var (day, on) in StreakDays())
                    {
                        var isToday = day == DateTime.Now.Date;
                        <div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
                            <div style="width:8px;height:@(on ? "26px" : "10px");border-radius:2px;background:@(on ? Theme.Gold : Theme.MutedDk + "70");transition:height .4s;"></div>
                            <span style="font-family:@Theme.Mono;font-size:8px;color:@(isToday ? Theme.Gold : Theme.MutedDk);">@day.ToString("ddd")[0]</span>
                        </div>
                    }
                </div>
            </div>

            @if (today.Due + today.New > 0)
            {
                <div @onclick='() => NavigationManager.NavigateTo("/review")' class="btn btn-gold" style="margin-top:18px;">
                    Start review <Icon Name="arrow-right" Size="16" Color="@Theme.Ink" />
                </div>
            }
            else if (hardCount > 0)
            {
                <div @onclick='() => NavigationManager.NavigateTo("/review?hard=true")' class="btn btn-ghost" style="margin-top:18px;">
                    All caught up · drill hard words
                </div>
            }
            else
            {
                <div style="margin-top:18px;font-size:13px;color:@Theme.Muted;">All caught up for today. Nice work.</div>
            }

            @if (listenNext != null)
            {
                var resumeAt = Player.Positions.GetValueOrDefault(listenNext.Id);
                var length = Player.Durations.GetValueOrDefault(listenNext.Id);
                var playingThis = Player.Episode?.Id == listenNext.Id && Player.Playing;
                <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;">
                    <span @onclick="() => ListenNow(listenNext)" class="tap" style="width:44px;height:44px;border-radius:50%;border:1px solid @Theme.Gold;flex-shrink:0;">
                        <Icon Name="@(playingThis ? "pause" : "play")" Size="16" Color="@Theme.Gold" />
                    </span>
                    <div @onclick='() => NavigationManager.NavigateTo("/commute")' style="flex:1;min-width:0;cursor:pointer;">
                        <div class="eyebrow">@(resumeAt > 0 ? "Continue listening" : "Next episode")</div>
                        <div style="font-family:@Theme.Serif;font-size:17px;color:@Theme.Cream;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@listenNext.Title</div>
                        @if (resumeAt > 0 && length > 0)
                        {
                            <div style="height:2px;background:var(--line);border-radius:2px;margin-top:8px;overflow:hidden;">
                                <div class="progress-fill" style="height:100%;width:@((int)(resumeAt * 100 / length))%;background:@Theme.Gold;"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @* Sections *@
    @foreach (var group in Groups)
    {
        <div style="padding:0 24px;margin-bottom:30px;">
            <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;">
                <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">@group.Title</span>
                <span style="font-family:@Theme.Sans;font-size:11px;color:@Theme.MutedDk;">@group.Caption</span>
            </div>

            @for (int i = 0; i < group.Items.Length; i++)
            {
                var it = group.Items[i];
                var last = i == group.Items.Length - 1;
                <div @onclick="() => OpenLesson(it)"
                     style="display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:@(last ? "none" : "1px solid " + Theme.MutedDk + "40");opacity:@(it.Soon ? "0.5" : "1");cursor:@(it.Soon ? "default" : "pointer");">
                    <div style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Gold;width:24px;">@it.N</div>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="font-family:@Theme.Serif;font-size:22px;color:@Theme.Cream;line-height:1.1;letter-spacing:-0.3px;">@it.T</span>
                            @if (it.Url == "/review" && dueCount > 0)
                            {
                                <span style="font-family:@Theme.Mono;font-size:10px;font-weight:600;padding:3px 8px;border-radius:100px;background:@Theme.Gold;color:@Theme.Ink;">@dueCount</span>
                            }
                            @if (it.Url == "/review" && hardCount > 0)
                            {
                                <span @onclick='() => NavigationManager.NavigateTo("/review?hard=true")' @onclick:stopPropagation="true"
                                      style="font-family:@Theme.Mono;font-size:10px;padding:3px 8px;border-radius:100px;border:1px solid @Theme.Gold;color:@Theme.Gold;cursor:pointer;">★ @hardCount hard</span>
                            }
                        </div>
                        <div style="font-family:@Theme.Sans;font-size:12px;color:@Theme.Muted;margin-top:4px;">@it.Sub</div>
                        @if (lessonProgress.TryGetValue(it.Url, out var lp) && lp.Seen > 0)
                        {
                            <div style="display:flex;align-items:center;gap:10px;margin-top:8px;">
                                <div style="flex:1;height:3px;border-radius:2px;background:@(Theme.MutedDk + "40");position:relative;overflow:hidden;">
                                    <div style="position:absolute;left:0;top:0;bottom:0;width:@(lp.Seen * 100 / lp.Total)%;background:@(Theme.Gold + "50");"></div>
                                    <div style="position:absolute;left:0;top:0;bottom:0;width:@(lp.Known * 100 / lp.Total)%;background:@Theme.Gold;"></div>
                                </div>
                                <span style="font-family:@Theme.Mono;font-size:10px;color:@Theme.Muted;white-space:nowrap;">@lp.Known/@lp.Total known</span>
                            </div>
                        }
                    </div>
                    <div style="font-family:@Theme.Deva;font-size:20px;color:@Theme.Gold;opacity:0.85;">@it.Deva</div>
                    @if (!it.Soon)
                    {
                        <Icon Name="chevron-right" Size="18" Color="@Theme.Muted" />
                    }
                </div>
            }
        </div>
    }

    <div style="height:40px;"></div>
    <NavBar />
</div>

@code {
    private StreakInfo? streak;
    private int dueCount;
    private int hardCount;
    private (int Due, int New) today;
    private bool loaded;
    private LearnMarathi.Models.CommuteEpisode? listenNext;

    // Plays from the home screen; the mini player takes over from here.
    private async Task ListenNow(LearnMarathi.Models.CommuteEpisode ep)
    {
        if (Player.Episode?.Id == ep.Id) await Player.TogglePlayAsync();
        else await Player.OpenAsync(ep, play: true);
    }

    private Dictionary<string, (int Seen, int Known, int Total)> lessonProgress = new();


    private record Lesson(string N, string T, string Sub, string Deva, string Url, bool Soon);

    // Which SRS decks count towards each lesson's progress bar.
    private static readonly Dictionary<string, string[]> LessonDecks = new()
    {
        ["/commute"] = new[] { "commute" },
        ["/listening"] = new[] { "listen_words", "listen_phrases" },
        ["/sentences"] = new[] { "sentences" },
        ["/characters"] = new[] { "characters" },
        ["/barakhadi"] = new[] { "barakhadi", "conjuncts" },
        ["/commonwords"] = new[] { "words" },
        ["/numbers"] = new[] { "numbers" },
        ["/phrases"] = new[] { "listen_phrases" },
        ["/verbs"] = new[] { "verbs" },
    };
    private record Group(string Title, string Caption, Lesson[] Items);

    private static readonly Group[] Groups =
    {
        new("Practice", "drills", new[] {
            new Lesson("01", "Review",    "Everything due, all decks",   "उजळणी",    "/review",    false),
            new Lesson("02", "Commute",   "Guided audio for the train",  "प्रवास",    "/commute",   false),
            new Lesson("03", "Listening", "Sound first, no script",      "ऐकणे",     "/listening", false),
            new Lesson("04", "Sentences", "Build it word by word",       "वाक्यरचना", "/sentences", false),
        }),
        new("Script", "reading", new[] {
            new Lesson("05", "Characters", "Devanagari foundations",     "अक्षरे",   "/characters", false),
            new Lesson("06", "Barakhadi",  "Vowel signs and conjuncts",  "बाराखडी",  "/barakhadi",  false),
        }),
        new("Vocabulary", "words", new[] {
            new Lesson("07", "Common Words", "By category, by frequency", "शब्द",   "/commonwords", false),
            new Lesson("08", "Numbers",      "One to a hundred",          "अंक",    "/numbers",     false),
            new Lesson("09", "Phrases",      "Everyday chunks",           "वाक्ये",  "/phrases",     false),
        }),
        new("Structure", "grammar", new[] {
            new Lesson("10", "Verbs",   "Endings that agree with you", "क्रियापदे", "/verbs",   false),
            new Lesson("11", "Grammar", "Patterns and tenses",         "व्याकरण",   "/grammar", false),
        }),
    };

    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Player.Changed -= OnPlayerChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            streak = await Streak.GetAsync();
            dueCount = await Review.GetDueCountAsync();
            today = await Review.GetTodayCountsAsync();
            await Player.InitAsync();
            listenNext = Player.Episode
                ?? Player.Episodes.FirstOrDefault(e => Player.Positions.ContainsKey(e.Id))
                ?? Player.Episodes.FirstOrDefault(e => !Player.Listened.Contains(e.Id) && Player.Durations.ContainsKey(e.Id));
            loaded = true;
            hardCount = (await HardWords.GetAllAsync()).Count;
            var progress = await Review.GetProgressAsync();
            lessonProgress = LessonDecks.ToDictionary(kv => kv.Key, kv =>
            {
                var cards = progress.Where(p => kv.Value.Contains(p.Card.Deck)).ToList();
                return (cards.Count(p => p.Mastery != Mastery.New), cards.Count(p => p.Mastery == Mastery.Known), cards.Count);
            });
            StateHasChanged();
        }
    }

    /// <summary>The last 7 days, oldest first, flagged if they fall inside the current streak.</summary>
    private IEnumerable<(DateTime Day, bool On)> StreakDays()
    {
        var today = DateTime.Now.Date;
        var count = streak?.CurrentStreak ?? 0;
        var last = streak?.LastActiveDate;
        for (var i = 6; i >= 0; i--)
        {
            var day = today.AddDays(-i);
            var on = last != null && day <= last && day > last.Value.AddDays(-count);
            yield return (day, on);
        }
    }

    private void OpenLesson(Lesson l)
    {
        if (l.Soon || string.IsNullOrEmpty(l.Url)) return;
        NavigationManager.NavigateTo(l.Url);
    }
}
