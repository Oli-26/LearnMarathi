@page "/mywords"
@using LearnMarathi.Services
@implements IDisposable
@inject IReviewService ReviewService
@inject IHardWordsService HardWords
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>My words · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">

    <PageHead Title="My words" Marathi="माझे शब्द" Eyebrow="Progress" Glyph="book"
              Blurb="Every word, verb and phrase in the app, and how well each one has stuck. Star the ones that keep tripping you up." />

    @if (isLoading)
    {
        <div style="padding:24px;display:grid;gap:12px;"><div class="skeleton" style="height:120px;border-radius:18px;"></div><div class="skeleton" style="height:52px;"></div><div class="skeleton" style="height:52px;"></div></div>
    }
    else
    {
        <div style="display:flex;gap:8px;padding:18px 24px 0;">
            @foreach (var (key, label) in new[] { ("all", "All words"), ("hard", $"Hard words · {hardRows.Count}") })
            {
                var active = tab == key;
                <span @onclick="() => tab = key"
                      class="chip @(active ? "is-active" : "")">@label</span>
            }
        </div>

        @if (tab == "all")
        {
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:16px 24px 4px;">
                @foreach (var m in new[] { Mastery.Learning, Mastery.Known, Mastery.New })
                {
                    var active = masteryFilter == m;
                    <div @onclick="() => masteryFilter = active ? null : m"
                         style="padding:12px 10px;border-radius:12px;cursor:pointer;border:1px solid @(active ? MasteryColor(m) : Theme.MutedDk + "40");background:@(active ? MasteryColor(m) + "18" : Theme.Ink2);">
                        <div style="font-family:@Theme.Serif;font-size:28px;line-height:1;color:@MasteryColor(m);">@items.Count(i => i.Mastery == m)</div>
                        <div style="font-family:@Theme.Mono;font-size:9px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;margin-top:6px;">@m</div>
                    </div>
                }
            </div>

            <div style="display:flex;gap:8px;padding:12px 24px;overflow-x:auto;">
                @foreach (var c in categories.Prepend("All"))
                {
                    var active = category == c;
                    <span @onclick="() => category = c"
                          class="chip @(active ? "is-active" : "")">@c</span>
                }
            </div>

            <div style="padding:4px 24px 24px;">
                @if (!Visible.Any())
                {
                    <div style="padding:30px 0;text-align:center;font-size:13px;color:@Theme.Muted;">Nothing here yet.</div>
                }
                @foreach (var w in Visible)
                {
                    @WordRowView(w, false)
                }
            </div>
        }
        else
        {
            <div style="padding:16px 24px 24px;">
                <div @onclick="DrillHard"
                     style="padding:15px;border-radius:100px;text-align:center;font-weight:600;cursor:@(hardRows.Count > 0 ? "pointer" : "default");background:@(hardRows.Count > 0 ? Theme.Cream : Theme.Ink2);color:@(hardRows.Count > 0 ? Theme.Ink : Theme.MutedDk);">
                    Drill hard words
                </div>

                @if (!adding)
                {
                    <div @onclick="() => adding = true"
                         style="margin-top:12px;padding:13px;border-radius:100px;text-align:center;cursor:pointer;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;display:flex;align-items:center;justify-content:center;gap:8px;">
                        <Icon Name="plus" Size="16" Color="@Theme.Cream" /> Add your own word
                    </div>
                }
                else
                {
                    <div style="margin-top:14px;padding:16px;border-radius:14px;background:@Theme.Ink2;border:1px solid @(Theme.MutedDk + "40");">
                        <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">New word</div>
                        <input placeholder="मराठी" value="@newMarathi" @oninput="OnMarathiInput"
                               style="@InputStyle font-family:@Theme.Deva;font-size:20px;" />
                        <input placeholder="English meaning" @bind="newEnglish" @bind:event="oninput" style="@InputStyle" />
                        <input placeholder="Romanised (optional)" @bind="newRoman" @bind:event="oninput" style="@InputStyle font-family:@Theme.Mono;font-size:13px;" />
                        @if (autoFilled)
                        {
                            <div style="font-size:11px;color:@Theme.Gold;margin-top:8px;">Already in the app, so meaning and romanisation were filled in.</div>
                        }
                        <div style="display:flex;gap:10px;margin-top:14px;">
                            <div @onclick="CancelAdd" style="flex:1;padding:12px;text-align:center;border-radius:100px;border:1px solid @(Theme.MutedDk + "80");cursor:pointer;">Cancel</div>
                            <div @onclick="SaveNewWord"
                                 style="flex:1;padding:12px;text-align:center;border-radius:100px;font-weight:600;cursor:pointer;background:@(CanSave ? Theme.Gold : Theme.MutedDk + "40");color:@(CanSave ? Theme.Ink : Theme.Muted);">Save</div>
                        </div>
                    </div>
                }

                @if (suggestions.Count > 0)
                {
                    <div style="margin-top:26px;font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Keep missing these?</div>
                    @foreach (var s in suggestions)
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid @(Theme.MutedDk + "30");">
                            <div @onclick="() => Speak(s.Card.Front)" style="flex:1;min-width:0;cursor:pointer;">
                                <span style="font-family:@Theme.Deva;font-size:20px;color:@Theme.Cream;">@s.Card.Front</span>
                                <div style="font-size:12px;color:@Theme.Muted;margin-top:2px;">@s.Card.Back · missed @s.Wrong×</div>
                            </div>
                            <span @onclick="() => HardWords.SetAsync(s.Card.Front, true)" title="Add to hard words"
                                  style="padding:7px 12px;border-radius:100px;background:@Theme.Gold;color:@Theme.Ink;font-size:12px;font-weight:600;cursor:pointer;">Add</span>
                            <span @onclick="() => HardWords.DismissSuggestionAsync(s.Card.Front)" title="Not hard" style="display:inline-flex;padding:6px;cursor:pointer;">
                                <Icon Name="x" Size="16" Color="@Theme.MutedDk" />
                            </span>
                        </div>
                    }
                }

                <div style="margin-top:26px;font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Your list</div>
                @if (hardRows.Count == 0)
                {
                    <div style="padding:24px 0;font-size:13px;color:@Theme.Muted;line-height:1.7;text-align:center;">
                        <div style="margin-bottom:16px;"><WarliDancers Count="3" Opacity="0.5" /></div>
                        Empty for now. Tap ☆ on any word here, in Review after answering, or on Commute key words. A word leaves the list once it reaches Known.
                    </div>
                }
                @foreach (var w in hardRows)
                {
                    @WordRowView(w, true)
                }
            </div>
        }
    }

    <NavBar />
</div>

@code {
    private record WordRow(string Marathi, string English, string Pronunciation, string Category,
                           Mastery Mastery, int Correct, int Wrong, bool Due, int Order, string? CustomId);

    private static readonly HashSet<string> VocabDecks = new() { "words", "listen_words", "verbs", "listen_phrases", "commute", HardWordsService.CustomDeck };

    private const string InputStyle = $"width:100%;box-sizing:border-box;margin-top:10px;padding:11px 12px;border-radius:10px;border:1px solid {Theme.MutedDk}80;background:{Theme.Ink};color:{Theme.Cream};font-size:14px;outline:none;";

    private List<WordRow> items = new();
    private List<WordRow> hardRows = new();
    private List<CardProgress> suggestions = new();
    private List<string> categories = new();
    private Dictionary<string, ReviewCard> byFront = new();
    private Mastery? masteryFilter;
    private string category = "All";
    private string tab = "all";
    private bool isLoading = true;

    private bool adding;
    private bool autoFilled;
    private string newMarathi = "";
    private string newEnglish = "";
    private string newRoman = "";

    protected override async Task OnInitializedAsync()
    {
        HardWords.Changed += OnHardChanged;
        await ReviewService.GraduateHardAsync();
        await LoadAsync();
        isLoading = false;
    }

    private async Task LoadAsync()
    {
        var progress = await ReviewService.GetProgressAsync();
        var hard = await HardWords.GetAllAsync();
        var customIds = (await HardWords.GetCustomAsync()).ToDictionary(w => w.Marathi, w => w.Id);

        var rows = BuildRows(progress, customIds);
        items = rows.Where(r => r.InVocab).Select(r => r.Row).ToList();
        hardRows = rows.Where(r => hard.Contains(r.Row.Marathi)).Select(r => r.Row)
                       .OrderBy(r => r.Mastery switch { Mastery.Learning => 0, Mastery.New => 1, _ => 2 })
                       .ThenBy(r => r.Order).ToList();
        suggestions = await ReviewService.GetHardSuggestionsAsync();
        byFront = progress.Select(p => p.Card).Where(c => c.Deck != HardWordsService.CustomDeck)
                          .GroupBy(c => c.Front).ToDictionary(g => g.Key, g => g.First());
        categories = items.Select(i => i.Category).Distinct().OrderBy(c => c).ToList();
    }

    // A word can sit in several decks (Words and Listening, say); merge them and report the weaker result.
    private static List<(WordRow Row, bool InVocab)> BuildRows(List<CardProgress> progress, Dictionary<string, string> customIds) =>
        progress
            .Select((p, i) => (p, i))
            .GroupBy(t => t.p.Card.Front)
            .Select(g =>
            {
                // Same spelling can be both a word and a Barakhadi syllable (हो); the word's cards win.
                var inVocab = g.Any(t => VocabDecks.Contains(t.p.Card.Deck));
                var cards = inVocab ? g.Where(t => VocabDecks.Contains(t.p.Card.Deck)).ToList() : g.ToList();
                var card = cards.OrderBy(t => t.p.Card.Deck == HardWordsService.CustomDeck ? 1 : 0).First().p.Card;
                var seen = cards.Where(t => t.p.Mastery != Mastery.New).Select(t => t.p).ToList();
                var mastery = seen.Count == 0 ? Mastery.New : seen.Min(p => p.Mastery);
                var row = new WordRow(card.Front, card.Back, card.Pronunciation, CategoryOf(card), mastery,
                    cards.Sum(t => t.p.Correct), cards.Sum(t => t.p.Wrong), cards.Any(t => t.p.Due), cards.First().i,
                    customIds.GetValueOrDefault(card.Front));
                return (row, inVocab);
            })
            .ToList();

    private IEnumerable<WordRow> Visible => items
        .Where(i => masteryFilter == null || i.Mastery == masteryFilter)
        .Where(i => category == "All" || i.Category == category)
        .OrderBy(i => i.Mastery switch { Mastery.Learning => 0, Mastery.Known => 1, _ => 2 })
        .ThenBy(i => i.Correct + i.Wrong == 0 ? 1.0 : (double)i.Correct / (i.Correct + i.Wrong))
        .ThenBy(i => i.Order);

    private RenderFragment WordRowView(WordRow w, bool inHardList) => @<div @onclick="() => Speak(w.Marathi)"
         style="display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid @(Theme.MutedDk + "30");cursor:pointer;">
        <div style="width:4px;align-self:stretch;border-radius:2px;background:@MasteryColor(w.Mastery);"></div>
        <div style="flex:1;min-width:0;">
            <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;">
                <span style="font-family:@Theme.Deva;font-size:22px;color:@Theme.Cream;line-height:1.3;">@w.Marathi</span>
                <span style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;">@w.Pronunciation</span>
            </div>
            <div style="font-size:13px;color:@Theme.Muted;margin-top:2px;">@w.English</div>
        </div>
        <div style="text-align:right;flex-shrink:0;">
            @if (w.Mastery != Mastery.New)
            {
                <div style="font-family:@Theme.Mono;font-size:12px;color:@Theme.Cream;">@w.Correct/@(w.Correct + w.Wrong)</div>
            }
            @if (w.Due)
            {
                <div style="font-family:@Theme.Mono;font-size:9px;letter-spacing:1.5px;color:@Theme.Gold;text-transform:uppercase;margin-top:4px;">Due</div>
            }
        </div>
        @if (inHardList && w.CustomId != null)
        {
            <span @onclick="() => HardWords.RemoveCustomAsync(w.CustomId)" @onclick:stopPropagation="true" title="Delete your word"
                  style="display:inline-flex;padding:6px;cursor:pointer;">
                <Icon Name="trash" Size="17" Color="@Theme.MutedDk" />
            </span>
        }
        else
        {
            <StarButton Marathi="@w.Marathi" />
        }
    </div>;

    private void OnMarathiInput(ChangeEventArgs e)
    {
        newMarathi = e.Value?.ToString() ?? "";
        if (byFront.TryGetValue(newMarathi.Trim(), out var known))
        {
            if (newEnglish.Length == 0) newEnglish = known.Back;
            if (newRoman.Length == 0) newRoman = known.Pronunciation;
            autoFilled = true;
        }
        else autoFilled = false;
    }

    private bool CanSave => newMarathi.Trim().Length > 0 && newEnglish.Trim().Length > 0;

    private async Task SaveNewWord()
    {
        if (!CanSave) return;
        var marathi = newMarathi.Trim();
        // A word the app already teaches only needs starring; a new one becomes a custom card.
        if (byFront.ContainsKey(marathi)) await HardWords.SetAsync(marathi, true);
        else await HardWords.AddCustomAsync(marathi, newEnglish, newRoman);
        CancelAdd();
    }

    private void CancelAdd()
    {
        adding = autoFilled = false;
        newMarathi = newEnglish = newRoman = "";
    }

    private void DrillHard()
    {
        if (hardRows.Count > 0) NavigationManager.NavigateTo("/review?hard=true");
    }

    private async void OnHardChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string CategoryOf(ReviewCard card) => card.Deck switch
    {
        "verbs" => "Verbs",
        "listen_phrases" => "Phrases",
        "commute" => "Commute",
        HardWordsService.CustomDeck => "My own",
        _ => card.Group.StartsWith("words:") ? card.Group["words:".Length..] : card.DeckLabel
    };

    private static string MasteryColor(Mastery m) => m switch
    {
        Mastery.Known => Theme.Gold,
        Mastery.Learning => Theme.Cream,
        _ => Theme.MutedDk
    };

    private async Task Speak(string text) => await JSRuntime.InvokeVoidAsync("speakMarathi", text);

    public void Dispose() => HardWords.Changed -= OnHardChanged;
}
