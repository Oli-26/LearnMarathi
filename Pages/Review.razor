@page "/review"
@using LearnMarathi.Services
@inject IReviewService ReviewService
@inject ISrsService Srs
@inject IStreakService Streak
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Review · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">

    <PageHead Title="Review" Marathi="उजळणी" Eyebrow="Practice" Glyph="flame" Compact="@(queue.Count > 0 && !finished)"
              Blurb="Everything you have met, from every deck, shuffled together and served when it is about to slip. Plus a few new words each day." />

    @if (isLoading)
    {
        <div style="padding:40px 24px;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Loading…</div>
    }
    else if (queue.Count == 0 && !started)
    {
        <div style="padding:40px 24px;text-align:center;">
            <div style="font-family:@Theme.Serif;font-size:26px;color:@Theme.Cream;">All done for today.</div>
            <div style="font-size:13px;color:@Theme.Muted;line-height:1.7;margin-top:12px;max-width:280px;margin-left:auto;margin-right:auto;">
                Nothing is due and today's new words are learned. Come back tomorrow, or open a lesson to keep going.
            </div>
            <div @onclick='() => NavigationManager.NavigateTo("/")'
                 style="margin:26px auto 0;max-width:220px;padding:15px;border-radius:100px;background:@Theme.Cream;color:@Theme.Ink;font-weight:600;cursor:pointer;">
                Back to lessons
            </div>
        </div>
    }
    else if (finished)
    {
        <div style="padding:40px 24px;text-align:center;">
            @{ var quizzed = queue.Count(c => !c.IsNew); var learned = queue.Count - quizzed; }
            @if (quizzed > 0)
            {
                <div style="font-family:@Theme.Serif;font-size:46px;color:@Theme.Gold;line-height:1;">@score/@quizzed</div>
            }
            @if (learned > 0)
            {
                <div style="font-family:@Theme.Serif;font-size:@(quizzed > 0 ? "20px" : "46px");color:@(quizzed > 0 ? Theme.Cream : Theme.Gold);line-height:1;margin-top:@(quizzed > 0 ? "14px" : "0");">+@learned new</div>
            }
            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;margin-top:12px;">Session complete</div>
            <div @onclick="Reload"
                 style="margin:28px auto 0;max-width:220px;padding:15px;border-radius:100px;background:@Theme.Cream;color:@Theme.Ink;font-weight:600;cursor:pointer;">
                Review again
            </div>
        </div>
    }
    else if (current != null)
    {
        <div style="padding:22px 24px 24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">@current.DeckLabel · @ModeLabel</span>
                <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;">@(index + 1) / @total</span>
            </div>

            <div style="height:3px;background:@(Theme.MutedDk + "40");border-radius:2px;margin-top:10px;overflow:hidden;">
                <div style="height:100%;width:@(total == 0 ? 0 : index * 100 / total)%;background:@Theme.Gold;"></div>
            </div>

            @if (current.IsNew)
            {
                <div style="margin:26px 0;padding:34px 18px;background:@Theme.Ink2;border-radius:18px;border:1px solid @(Theme.Gold + "60");text-align:center;">
                    <div style="font-family:@Theme.Deva;font-size:@(current.Front.Length > 12 ? "30px" : "52px");color:@Theme.Cream;line-height:1.3;">@current.Front</div>
                    <div style="font-family:@Theme.Mono;font-size:12px;color:@Theme.Muted;font-style:italic;margin-top:8px;">@current.Pronunciation</div>
                    <div style="font-family:@Theme.Serif;font-size:26px;color:@Theme.Gold;margin-top:18px;line-height:1.2;">@current.Back</div>
                    <div @onclick="() => Speak(current.Front)" style="margin-top:18px;display:inline-flex;cursor:pointer;">
                        <Icon Name="speaker" Size="22" Color="@Theme.Cream" />
                    </div>
                </div>
                <div style="font-size:12px;color:@Theme.Muted;text-align:center;line-height:1.6;">You will be asked this one from tomorrow.</div>
                <QuizNext Visible="true" Label="Got it" OnClick="LearnNew" />
            }
            else
            {
                <div style="margin:26px 0;padding:34px 18px;background:@Theme.Ink2;border-radius:18px;border:1px solid @(Theme.MutedDk + "30");text-align:center;">
                    @if (mode == ReviewMode.Listen && !answered)
                    {
                        <div @onclick="() => Speak(current.Front)"
                             style="display:inline-flex;padding:22px;border-radius:50%;cursor:pointer;background:@(Theme.Gold + "20");">
                            <Icon Name="speaker" Size="40" Color="@Theme.Gold" />
                        </div>
                    }
                    else
                    {
                        @if (mode is ReviewMode.Produce or ReviewMode.Say)
                        {
                            <div style="font-family:@Theme.Serif;font-size:@(current.Back.Length > 16 ? "22px" : "32px");color:@Theme.Cream;line-height:1.3;">@current.Back</div>
                        }
                        @if (mode is not (ReviewMode.Produce or ReviewMode.Say) || answered)
                        {
                            <div style="font-family:@Theme.Deva;font-size:@(current.Front.Length > 12 ? "26px" : "46px");color:@Theme.Cream;line-height:1.3;margin-top:@(mode is ReviewMode.Produce or ReviewMode.Say ? "12px" : "0");">@current.Front</div>
                        }
                        @if (answered)
                        {
                            <div style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;margin-top:10px;">@current.Pronunciation</div>
                        }
                        <div @onclick="() => Speak(current.Front)" style="margin-top:14px;display:inline-flex;cursor:pointer;">
                            <Icon Name="speaker" Size="18" Color="@Theme.Muted" />
                        </div>
                    }
                </div>

                @if (mode == ReviewMode.Say)
                {
                    @if (!answered)
                    {
                        <div style="text-align:center;">
                            <div @onclick="ListenForAnswer"
                                 style="display:inline-flex;padding:26px;border-radius:50%;cursor:pointer;background:@(listening ? Theme.Gold : Theme.Gold + "20");">
                                <Icon Name="mic" Size="40" Color="@(listening ? Theme.Ink : Theme.Gold)" />
                            </div>
                            <div style="font-size:13px;color:@Theme.Muted;margin-top:12px;line-height:1.6;">@(listening ? "Listening…" : sayMessage ?? "Tap, then say it in Marathi")</div>
                            <div @onclick="SkipSay"
                                 style="margin-top:22px;font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.MutedDk;text-transform:uppercase;cursor:pointer;">Can't speak now</div>
                        </div>
                    }
                    else
                    {
                        <div style="text-align:center;padding:14px;border-radius:14px;border:1px solid @(sayCorrect ? Theme.Gold : "#8B3A3A");">
                            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@(sayCorrect ? Theme.Gold : "#d96666");text-transform:uppercase;">@(sayCorrect ? "Heard" : "Heard instead")</div>
                            <div style="font-family:@Theme.Deva;font-size:22px;color:@Theme.Cream;margin-top:6px;">@(heard.FirstOrDefault() ?? "…")</div>
                        </div>
                        @if (!sayCorrect)
                        {
                            <div @onclick="OverrideSay"
                                 style="margin-top:12px;padding:14px;text-align:center;border-radius:100px;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;cursor:pointer;">I said it right</div>
                        }
                    }
                }
                else
                {
                    <div style="display:grid;gap:10px;">
                        @foreach (var opt in options)
                        {
                            var state = AnswerState(opt);
                            <div @onclick="() => Answer(opt)"
                                 style="padding:16px;border-radius:14px;cursor:pointer;text-align:center;font-family:@(mode == ReviewMode.Produce ? Theme.Deva : Theme.Serif);font-size:19px;
                                        border:1px solid @(state == "right" ? Theme.Gold : state == "wrong" ? "#8B3A3A" : Theme.MutedDk + "50");
                                        background:@(state == "right" ? Theme.Gold : state == "wrong" ? "#8B3A3A" : Theme.Ink2);
                                        color:@(state == "right" ? Theme.Ink : Theme.Cream);">@opt</div>
                        }
                    </div>
                }
                <QuizNext Visible="answered" Label="@(index + 1 >= total ? "Finish" : "Next")" OnClick="Advance" />
            }
        </div>
    }

    <NavBar />
</div>

@code {
    private const int SessionSize = 20;

    private enum ReviewMode { Recognise, Produce, Listen, Say }

    // Decks whose fronts are single words or short verbs; the recogniser copes badly with long sentences.
    private static readonly HashSet<string> SayDecks = new() { "words", "verbs", "commute" };

    private bool speechOk;
    private bool listening;
    private bool sayCorrect;
    private bool pendingSayWrong;
    private string? sayMessage;
    private List<string> heard = new();
    private ReviewMode mode;

    private List<ReviewCard> queue = new();
    private List<ReviewCard> allCards = new();
    private ReviewCard? current;
    private List<string> options = new();

    private int index;
    private int total;
    private int score;
    private bool answered;
    private bool started;
    private bool finished;
    private bool isLoading = true;
    private string chosen = "";
    private readonly Random rng = new();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        isLoading = true;
        finished = false;
        index = 0;
        score = 0;
        allCards = await ReviewService.GetAllCardsAsync();
        speechOk = await JSRuntime.InvokeAsync<bool>("speechAvailable");
        queue = await ReviewService.GetDueAsync(SessionSize);
        total = queue.Count;
        started = total > 0;
        isLoading = false;
        if (total > 0) await LoadCard();
    }

    private async Task LoadCard()
    {
        current = queue[index];
        mode = PickMode(current);
        answered = false;
        chosen = "";
        listening = false;
        sayCorrect = false;
        pendingSayWrong = false;
        sayMessage = null;
        heard = new();
        if (current.IsNew)
        {
            await Speak(current.Front);
            return;
        }

        BuildOptions();
        if (mode == ReviewMode.Listen) await Speak(current.Front);
    }

    private void BuildOptions()
    {
        var correct = OptionText(current!);
        // Same-topic distractors first (Monday vs Tuesday, not Monday vs apple), topped up from the deck.
        var sameGroup = allCards.Where(c => c.Group == current!.Group).OrderBy(_ => rng.Next());
        var sameDeck = allCards.Where(c => c.Deck == current!.Deck && c.Group != current!.Group).OrderBy(_ => rng.Next());
        options = sameGroup.Concat(sameDeck)
                           .Select(OptionText)
                           .Where(t => t != correct)
                           .Distinct()
                           .Take(3)
                           .Append(correct)
                           .OrderBy(_ => rng.Next())
                           .ToList();
    }

    private async Task ListenForAnswer()
    {
        if (listening || answered || current == null) return;
        listening = true;
        sayMessage = null;
        StateHasChanged();

        var attempt = await JSRuntime.InvokeAsync<SpeechAttempt>("recogniseSpeech", "mr-IN");
        listening = false;
        if (!attempt.Ok || attempt.Matches.Count == 0)
        {
            sayMessage = (attempt.Ok ? "Didn't catch that" : attempt.Message) + ". Tap to try again.";
            return;
        }

        heard = attempt.Matches;
        answered = true;
        sayCorrect = SpeechMatch.IsMatch(current.Front, heard);
        await Streak.TouchAsync();
        await Speak(current.Front);

        if (!sayCorrect)
        {
            // Recorded on Next rather than now, so "I said it right" can still overrule it.
            pendingSayWrong = true;
            return;
        }
        score++;
        await Srs.RecordAsync(current.Deck, current.Id, true);
        var answeredIndex = index;
        await Task.Delay(QuizNext.AutoAdvanceMs);
        if (index == answeredIndex && answered) await Advance();
    }

    private async Task OverrideSay()
    {
        if (current == null || !pendingSayWrong) return;
        pendingSayWrong = false;
        sayCorrect = true;
        score++;
        await Srs.RecordAsync(current.Deck, current.Id, true);
        await Advance();
    }

    private void SkipSay()
    {
        mode = ReviewMode.Recognise;
        BuildOptions();
    }

    private async Task LearnNew()
    {
        if (current == null) return;
        // Counts as a first correct rep, so the card falls due tomorrow as a normal question.
        await Srs.RecordAsync(current.Deck, current.Id, true);
        await ReviewService.MarkIntroducedAsync();
        await Streak.TouchAsync();
        await Advance();
    }

    private ReviewMode PickMode(ReviewCard card)
    {
        if (card.Deck.StartsWith("listen_")) return ReviewMode.Listen;
        var roll = rng.NextDouble();
        if (roll < 0.45) return ReviewMode.Recognise;
        if (roll < 0.7) return ReviewMode.Produce;
        if (roll < 0.85) return ReviewMode.Listen;
        return speechOk && SayDecks.Contains(card.Deck) ? ReviewMode.Say : ReviewMode.Recognise;
    }

    private string OptionText(ReviewCard card) => mode == ReviewMode.Produce ? card.Front : card.Back;

    private string ModeLabel => current?.IsNew == true ? "New" : mode switch
    {
        ReviewMode.Produce => "Pick the Marathi",
        ReviewMode.Listen => "Listen",
        ReviewMode.Say => "Say it",
        _ => "What does it mean?"
    };

    private string AnswerState(string opt)
    {
        if (!answered) return "";
        if (opt == OptionText(current!)) return "right";
        return opt == chosen ? "wrong" : "";
    }

    private async Task Answer(string opt)
    {
        if (answered || current == null) return;
        answered = true;
        chosen = opt;
        var correct = opt == OptionText(current);
        if (correct) score++;
        await Srs.RecordAsync(current.Deck, current.Id, correct);
        await Streak.TouchAsync();
        await Speak(current.Front);

        if (!correct) return;
        var answeredIndex = index;
        await Task.Delay(QuizNext.AutoAdvanceMs);
        if (index == answeredIndex && answered) await Advance();
    }

    private async Task Advance()
    {
        if (pendingSayWrong && current != null)
        {
            pendingSayWrong = false;
            await Srs.RecordAsync(current.Deck, current.Id, false);
        }
        index++;
        if (index >= total) { finished = true; return; }
        await LoadCard();
    }

    private async Task Speak(string text) => await JSRuntime.InvokeVoidAsync("speakMarathi", text);
}
