@page "/commonwords"
@using LearnMarathi.Data
@using LearnMarathi.Models
@using LearnMarathi.Services
@using Microsoft.JSInterop
@inject IBasicWordRepository Repository
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISrsService Srs
@inject IStreakService Streak

<PageTitle>Common Words · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">
    @if (showQuiz)
    {
        @* ---------- QUIZ VIEW ---------- *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;gap:14px;">
            <span @onclick="CloseQuiz" style="cursor:pointer;display:inline-flex;">
                <Icon Name="x" Size="20" Color="@Theme.Cream" />
            </span>
            <div style="flex:1;height:3px;background:@(Theme.MutedDk + "60");border-radius:2px;position:relative;">
                <div style="position:absolute;left:0;top:0;height:100%;width:@(ProgressPercent)%;background:@Theme.Gold;border-radius:2px;transition:width .3s;"></div>
            </div>
            <span style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;">@correctAnswers/@(correctAnswers + wrongAnswers)</span>
        </div>

        <div style="padding:24px 24px 0;display:flex;align-items:center;justify-content:space-between;gap:12px;">
            <div>
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">@(listeningMode ? "Listening Quiz" : "Words Quiz")</div>
                <div style="font-family:@Theme.Serif;font-size:22px;color:@Theme.Cream;margin-top:6px;line-height:1.2;letter-spacing:-0.4px;">@(currentQuestion?.QuestionText ?? "")</div>
            </div>
            <select @bind="difficultyLevel" @bind:event="onchange"
                    style="background:@Theme.Ink2;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;padding:6px 10px;border-radius:8px;font-family:@Theme.Mono;font-size:11px;">
                <option value="2">2</option>
                <option value="4">4</option>
                <option value="6">6</option>
                <option value="8">8</option>
            </select>
        </div>

        @if (currentQuestion != null)
        {
            <div style="margin:28px 24px;padding:36px 0;text-align:center;border-top:1px solid @Theme.Gold;border-bottom:1px solid @Theme.Gold;cursor:pointer;" @onclick="ReplayAudio" title="Tap to hear">
                @if (listeningMode)
                {
                    <div style="display:flex;justify-content:center;align-items:center;height:130px;">
                        <Icon Name="speaker" Size="80" Color="@Theme.Gold" Stroke="1.4" />
                    </div>
                }
                else
                {
                    var marathiQ = currentQuestion.DisplayWord == currentQuestion.AudioWord;
                    <div style="font-family:@(marathiQ ? Theme.Deva : Theme.Serif);font-size:@(marathiQ ? 86 : 32)px;color:@Theme.Gold;line-height:1;letter-spacing:@(marathiQ ? "0" : "-0.5px");">@currentQuestion.DisplayWord</div>
                }
            </div>

            @if (listeningMode)
            {
                <div style="text-align:center;margin:-12px 0 18px;">
                    <span @onclick="ReplayAudio"
                          style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border:1px solid @(Theme.MutedDk + "80");border-radius:100px;cursor:pointer;font-family:@Theme.Mono;font-size:11px;letter-spacing:1.5px;color:@Theme.Cream;text-transform:uppercase;">
                        <Icon Name="refresh" Size="14" Color="@Theme.Cream" /> Replay
                    </span>
                </div>
            }

            <div style="padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                @{ int letterIdx = 0; var letters = new[] { "A","B","C","D","E","F","G","H" }; }
                @foreach (var option in currentQuestion.Options)
                {
                    var optClass = GetOptionClass(option);
                    var isPicked = answerSelected && option == selectedAnswer;
                    var isCorrectOpt = answerSelected && option == currentQuestion.CorrectAnswer;
                    var bg = isCorrectOpt ? Theme.Gold : (isPicked && !isCorrect ? "#5a2828" : "transparent");
                    var border = isCorrectOpt ? Theme.Gold : (isPicked && !isCorrect ? "#a04040" : Theme.MutedDk + "80");
                    var fg = isCorrectOpt ? Theme.Ink : Theme.Cream;
                    var letter = letters[letterIdx % letters.Length];
                    var captured = option;
                    letterIdx++;
                    var isMarathiOption = ContainsDevanagari(option);
                    <button @onclick="() => CheckAnswer(captured)" disabled="@answerSelected"
                            style="padding:16px 14px;border-radius:12px;background:@bg;border:1px solid @border;color:@fg;display:flex;align-items:center;gap:12px;cursor:@(answerSelected ? "default" : "pointer");text-align:left;">
                        <span style="width:26px;height:26px;border-radius:50%;border:1px solid @(isCorrectOpt ? Theme.Ink : Theme.Muted);display:flex;align-items:center;justify-content:center;font-family:@Theme.Mono;font-size:11px;flex-shrink:0;">@letter</span>
                        <span style="font-family:@(isMarathiOption ? Theme.Deva : Theme.Serif);font-size:@(isMarathiOption ? 22 : 17)px;letter-spacing:-0.3px;flex:1;line-height:1.2;">@option</span>
                    </button>
                }
            </div>

            @if (answerSelected)
            {
                <div style="margin:24px 24px 0;padding:16px 18px;background:@(isCorrect ? Theme.Gold + "18" : "#5a282818");border-left:2px solid @(isCorrect ? Theme.Gold : "#d96666");border-radius:2px 8px 8px 2px;">
                    <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@(isCorrect ? Theme.Gold : "#d96666");text-transform:uppercase;">@(isCorrect ? "✓ Correct" : "✗ Wrong")</div>
                    @if (!isCorrect)
                    {
                        <div style="font-family:@Theme.Serif;font-size:16px;color:@Theme.Cream;margin-top:6px;">Answer: <span style="color:@Theme.Gold;">@currentQuestion.CorrectAnswer</span></div>
                    }
                </div>
                <QuizNext Visible="true" Label="Continue" OnClick="GenerateNewQuestion" />
            }
        }
    }
    else
    {
        @* ---------- LIST VIEW ---------- *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
            <span @onclick='() => NavigateToPage("/")' style="cursor:pointer;display:inline-flex;">
                <Icon Name="arrow-left" Size="20" Color="@Theme.Cream" />
            </span>
            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Lesson 02</span>
            <Icon Name="target" Size="20" Color="@Theme.Gold" />
        </div>

        <div style="padding:18px 24px 6px;">
            <div style="font-family:@Theme.Serif;font-size:36px;line-height:1;color:@Theme.Cream;letter-spacing:-1px;">Common Words</div>
            <div style="font-family:@Theme.Deva;font-size:24px;color:@Theme.Gold;margin-top:6px;">शब्दसंग्रह</div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="margin:18px 24px;padding:16px;background:#5a282818;border-left:2px solid #d96666;border-radius:2px 8px 8px 2px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:#d96666;text-transform:uppercase;">Error</div>
                <div style="font-family:@Theme.Sans;font-size:13px;color:@Theme.Cream;margin-top:4px;">@errorMessage</div>
            </div>
        }

        @if (isLoading)
        {
            <div style="padding:40px 24px;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Loading…</div>
        }
        else if (words.Any())
        {
            @* Practice modes *@
            <div style="padding:18px 24px 0;display:flex;gap:10px;">
                <button @onclick="StartQuiz"
                        style="flex:1;padding:14px;border-radius:12px;background:@Theme.Gold;color:@Theme.Ink;border:none;display:flex;align-items:center;justify-content:center;gap:8px;font-family:@Theme.Sans;font-weight:600;font-size:13px;cursor:pointer;">
                    <Icon Name="target" Size="14" Color="@Theme.Ink" /> Quiz
                </button>
                <button @onclick="StartListeningQuiz"
                        style="flex:1;padding:14px;border-radius:12px;background:transparent;color:@Theme.Cream;border:1px solid @(Theme.MutedDk + "80");display:flex;align-items:center;justify-content:center;gap:8px;font-family:@Theme.Sans;font-weight:600;font-size:13px;cursor:pointer;">
                    <Icon Name="headphones" Size="14" Color="@Theme.Cream" /> Listening
                </button>
            </div>

            @* Category chips *@
            <div style="display:flex;gap:8px;padding:18px 24px;overflow-x:auto;">
                @{ var allCats = new[] { "All" }.Concat(categories).ToArray(); }
                @foreach (var c in allCats)
                {
                    var active = selectedCategory == c;
                    var cap = c;
                    <span @onclick="() => FilterByCategory(cap)"
                          style="padding:8px 14px;border-radius:100px;white-space:nowrap;border:1px solid @(active ? Theme.Gold : Theme.MutedDk + "80");background:@(active ? Theme.Gold : "transparent");color:@(active ? Theme.Ink : Theme.Cream);font-family:@Theme.Sans;font-size:12px;font-weight:500;cursor:pointer;">@c</span>
                }
            </div>

            @* Word list *@
            <div style="padding:8px 24px;">
                @{ int idx = 0; }
                @foreach (var word in filteredWords.OrderBy(w => w.Frequency).ThenBy(w => w.Id))
                {
                    idx++;
                    var w = word;
                    <div style="padding:18px 0;display:flex;gap:14px;align-items:flex-start;border-top:1px solid @(Theme.MutedDk + "40");">
                        <span style="font-family:@Theme.Mono;font-size:10px;color:@Theme.Gold;margin-top:8px;min-width:22px;">@idx.ToString("D2")</span>
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
                                <span style="font-family:@Theme.Deva;font-size:32px;color:@Theme.Cream;">@w.MarathiWord</span>
                                <span style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;">@w.Pronunciation</span>
                            </div>
                            <div style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Gold;margin-top:4px;letter-spacing:-0.2px;">@w.EnglishTranslation</div>
                            <div style="font-family:@Theme.Mono;font-size:9px;color:@Theme.MutedDk;letter-spacing:1.5px;text-transform:uppercase;margin-top:8px;">— @w.Category · tier @w.Frequency</div>
                        </div>
                        <span @onclick="() => SpeakText(w.MarathiWord)"
                              style="width:36px;height:36px;border-radius:50%;border:1px solid @Theme.Gold;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;">
                            <Icon Name="speaker" Size="14" Color="@Theme.Gold" />
                        </span>
                    </div>
                }
            </div>
        }
    }

    <NavBar />
</div>

@code {
    private IEnumerable<BasicWord> words = new List<BasicWord>();
    private IEnumerable<BasicWord> filteredWords = new List<BasicWord>();
    private List<string> categories = new List<string>();
    private string selectedCategory = "All";
    private bool isLoading = true;
    private string errorMessage = "";

    // Quiz variables
    private bool showQuiz = false;
    private QuizQuestion? currentQuestion = null;
    private int _difficultyLevel = 4;
    private int difficultyLevel
    {
        get => _difficultyLevel;
        set
        {
            if (_difficultyLevel != value)
            {
                _difficultyLevel = value;
                if (showQuiz && !answerSelected)
                {
                    _ = GenerateNewQuestion();
                }
            }
        }
    }
    private const string SrsDeckWords = "words";
    private int currentCorrectId;
    private bool listeningMode = false;
    private int correctAnswers = 0;
    private int wrongAnswers = 0;
    private bool answerSelected = false;
    private bool isCorrect = false;
    private string selectedAnswer = "";
    private Random random = new Random();

    private int ProgressPercent
    {
        get
        {
            var total = correctAnswers + wrongAnswers;
            if (total == 0) return 0;
            return Math.Min(100, (int)(correctAnswers * 100.0 / Math.Max(total, 10)));
        }
    }

    private static bool ContainsDevanagari(string s)
    {
        if (string.IsNullOrEmpty(s)) return false;
        foreach (var ch in s) if (ch >= 0x0900 && ch <= 0x097F) return true;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            words = await Repository.GetAllWordsAsync();
            filteredWords = words;
            if (words.Any())
            {
                categories = words.Select(w => w.Category).Distinct().OrderBy(c => c).ToList();
            }
            else
            {
                errorMessage = "No words found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading words: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
        filteredWords = category == "All" ? words : words.Where(w => w.Category == category);
    }

    private void NavigateToPage(string url) => NavigationManager.NavigateTo(url);

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await JSRuntime.InvokeVoidAsync("speakMarathi", text);
    }

    private async Task StartQuiz()
    {
        showQuiz = true;
        listeningMode = false;
        correctAnswers = 0;
        wrongAnswers = 0;
        await GenerateNewQuestion();
    }

    private async Task StartListeningQuiz()
    {
        showQuiz = true;
        listeningMode = true;
        correctAnswers = 0;
        wrongAnswers = 0;
        await GenerateNewQuestion();
    }

    private void CloseQuiz()
    {
        showQuiz = false;
        listeningMode = false;
        currentQuestion = null;
        answerSelected = false;
    }

    private async Task GenerateNewQuestion()
    {
        if (!words.Any()) return;

        answerSelected = false;
        isCorrect = false;
        selectedAnswer = "";

        bool askMarathiToEnglish = listeningMode || random.Next(2) == 0;

        var wordsList = filteredWords.ToList();
        if (wordsList.Count == 0) return;

        var allIds = wordsList.Select(w => w.Id.ToString()).ToList();
        var prioritizedIds = await Srs.GetDueIdsAsync(SrsDeckWords, allIds, Math.Max(5, wordsList.Count / 4));
        BasicWord correctWord;
        if (prioritizedIds.Count > 0)
        {
            var pickedId = prioritizedIds[random.Next(prioritizedIds.Count)];
            correctWord = wordsList.FirstOrDefault(w => w.Id.ToString() == pickedId)
                ?? wordsList[random.Next(wordsList.Count)];
        }
        else
        {
            correctWord = wordsList[random.Next(wordsList.Count)];
        }
        currentCorrectId = correctWord.Id;

        var wrongOptions = wordsList
            .Where(w => w.Id != correctWord.Id)
            .OrderBy(x => random.Next())
            .Take(difficultyLevel - 1)
            .ToList();

        var allOptions = new List<string>();

        if (listeningMode)
        {
            allOptions.Add(correctWord.EnglishTranslation);
            allOptions.AddRange(wrongOptions.Select(w => w.EnglishTranslation));
            currentQuestion = new QuizQuestion
            {
                QuestionText = "Listen and pick the meaning",
                DisplayWord = correctWord.MarathiWord,
                CorrectAnswer = correctWord.EnglishTranslation,
                Options = allOptions.OrderBy(x => random.Next()).ToList(),
                AudioWord = correctWord.MarathiWord
            };
            await JSRuntime.InvokeVoidAsync("speakMarathi", correctWord.MarathiWord);
        }
        else if (askMarathiToEnglish)
        {
            allOptions.Add(correctWord.EnglishTranslation);
            allOptions.AddRange(wrongOptions.Select(w => w.EnglishTranslation));
            currentQuestion = new QuizQuestion
            {
                QuestionText = "What is the English translation?",
                DisplayWord = correctWord.MarathiWord,
                CorrectAnswer = correctWord.EnglishTranslation,
                Options = allOptions.OrderBy(x => random.Next()).ToList(),
                AudioWord = correctWord.MarathiWord
            };
        }
        else
        {
            allOptions.Add(correctWord.MarathiWord);
            allOptions.AddRange(wrongOptions.Select(w => w.MarathiWord));
            currentQuestion = new QuizQuestion
            {
                QuestionText = "What is the Marathi word?",
                DisplayWord = correctWord.EnglishTranslation,
                CorrectAnswer = correctWord.MarathiWord,
                Options = allOptions.OrderBy(x => random.Next()).ToList(),
                AudioWord = correctWord.MarathiWord
            };
        }
    }

    private async Task CheckAnswer(string answer)
    {
        if (answerSelected || currentQuestion == null) return;

        answerSelected = true;
        selectedAnswer = answer;
        isCorrect = answer == currentQuestion.CorrectAnswer;

        if (isCorrect) correctAnswers++; else wrongAnswers++;

        await Srs.RecordAsync(SrsDeckWords, currentCorrectId.ToString(), isCorrect);
        await Streak.TouchAsync();

        if (!isCorrect) return;
        var answeredQuestion = currentQuestion;
        await Task.Delay(QuizNext.AutoAdvanceMs);
        if (currentQuestion == answeredQuestion && answerSelected) await GenerateNewQuestion();
    }

    private async Task ReplayAudio()
    {
        if (currentQuestion?.AudioWord != null)
            await JSRuntime.InvokeVoidAsync("speakMarathi", currentQuestion.AudioWord);
    }

    private string GetOptionClass(string option)
    {
        if (!answerSelected) return "";
        if (option == currentQuestion?.CorrectAnswer) return "correct";
        if (option == selectedAnswer && !isCorrect) return "wrong";
        return "";
    }

    private class QuizQuestion
    {
        public string QuestionText { get; set; } = "";
        public string DisplayWord { get; set; } = "";
        public string CorrectAnswer { get; set; } = "";
        public List<string> Options { get; set; } = new();
        public string AudioWord { get; set; } = "";
    }
}
