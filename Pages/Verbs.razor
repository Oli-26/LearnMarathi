@page "/verbs"
@using LearnMarathi.Data
@using LearnMarathi.Models
@using LearnMarathi.Services
@inject IVerbRepository Repository
@inject ISrsService Srs
@inject IStreakService Streak
@inject IJSRuntime JSRuntime

<PageTitle>Verbs · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">

    <PageHead Title="Verbs" Marathi="क्रियापदे" Eyebrow="Lesson 06" Glyph="refresh" Compact="@(tab == "Drill")"
              Blurb="The verb ending changes with who is speaking — and with their gender. This is the habit English never trains." />

    @if (isLoading)
    {
        <div style="padding:40px 24px;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Loading…</div>
    }
    else
    {
        <div style="display:flex;gap:8px;padding:18px 24px 6px;">
            @foreach (var t in new[] { "Table", "Drill" })
            {
                var active = tab == t;
                <span @onclick="() => SwitchTab(t)"
                      style="padding:8px 14px;border-radius:100px;border:1px solid @(active ? Theme.Gold : Theme.MutedDk + "80");background:@(active ? Theme.Gold : "transparent");color:@(active ? Theme.Ink : Theme.Cream);font-size:12px;font-weight:500;cursor:pointer;">@t</span>
            }
        </div>

        @if (tab == "Table")
        {
            <div style="display:flex;gap:8px;padding:12px 24px;overflow-x:auto;">
                @foreach (var v in verbs)
                {
                    var active = selected?.Id == v.Id;
                    <span @onclick="() => selected = v"
                          style="flex:0 0 auto;padding:8px 14px;border-radius:100px;white-space:nowrap;border:1px solid @(active ? Theme.Gold : Theme.MutedDk + "80");background:@(active ? Theme.Gold : "transparent");color:@(active ? Theme.Ink : Theme.Cream);font-family:@Theme.Deva;font-size:15px;cursor:pointer;">@v.Infinitive</span>
                }
            </div>

            @if (selected != null)
            {
                <div style="padding:10px 24px 24px;">
                    <div style="padding:18px;background:@Theme.Ink2;border-radius:16px;border:1px solid @(Theme.MutedDk + "30");">
                        <div style="display:flex;align-items:baseline;justify-content:space-between;">
                            <div>
                                <div style="font-family:@Theme.Deva;font-size:28px;color:@Theme.Gold;">@selected.Infinitive</div>
                                <div style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;margin-top:2px;">@selected.Pronunciation</div>
                            </div>
                            <div style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Cream;">@selected.EnglishTranslation</div>
                        </div>

                        <div style="margin-top:18px;padding-top:16px;border-top:1px solid @(Theme.MutedDk + "40");">
                            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;margin-bottom:12px;">Present habitual</div>
                            @foreach (var p in Persons)
                            {
                                var spoken = $"{p.Subject} {Conjugate(selected, p)}";
                                <div @onclick="() => Speak(spoken)"
                                     style="display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid @(Theme.MutedDk + "22");cursor:pointer;">
                                    <div style="width:96px;font-family:@Theme.Mono;font-size:10px;letter-spacing:1px;color:@Theme.Muted;text-transform:uppercase;">@p.Label</div>
                                    <div style="font-family:@Theme.Deva;font-size:19px;color:@Theme.Cream;flex:1;">@p.Subject @Conjugate(selected, p)</div>
                                    <div style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Gold;">-@p.Ending</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div style="margin-top:18px;padding:16px;border:1px solid @(Theme.MutedDk + "40");border-radius:12px;font-size:12px;color:@Theme.Muted;line-height:1.7;">
                        Past and future tenses are not covered here yet. Marathi's past tense makes transitive verbs agree with the <em>object</em>, not the subject, which needs its own lesson rather than a row in this table.
                    </div>
                </div>
            }
        }
        else if (question != null)
        {
            <div style="padding:22px 24px 24px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">
                    Pick the right form · @score correct
                </div>

                <div style="margin:22px 0;padding:26px 18px;background:@Theme.Ink2;border-radius:18px;border:1px solid @(Theme.MutedDk + "30");text-align:center;">
                    <div style="font-family:@Theme.Serif;font-size:28px;color:@Theme.Cream;line-height:1.2;">@question.Prompt</div>
                    <div style="font-family:@Theme.Deva;font-size:20px;color:@Theme.Gold;margin-top:12px;">@question.Person.Subject …</div>
                </div>

                <div style="display:grid;gap:10px;">
                    @foreach (var opt in question.Options)
                    {
                        var state = AnswerState(opt);
                        <div @onclick="() => Answer(opt)"
                             style="padding:16px;border-radius:14px;cursor:pointer;text-align:center;font-family:@Theme.Deva;font-size:22px;
                                    border:1px solid @(state == "right" ? Theme.Gold : state == "wrong" ? "#8B3A3A" : Theme.MutedDk + "50");
                                    background:@(state == "right" ? Theme.Gold : state == "wrong" ? "#8B3A3A" : Theme.Ink2);
                                    color:@(state == "right" ? Theme.Ink : Theme.Cream);">@opt</div>
                    }
                </div>

                @if (answered)
                {
                    <div style="margin-top:18px;padding:14px 16px;border:1px solid @(Theme.MutedDk + "40");border-radius:12px;font-size:12px;color:@Theme.Muted;line-height:1.6;">
                        @question.Person.Hint
                    </div>
                    <QuizNext Visible="true" OnClick="NextQuestion" />
                }
            </div>
        }
    }

    <NavBar />
</div>

@code {
    private record Person(string Label, string Subject, string Ending, string EnglishSubject, string Hint);
    private record Question(Verb Verb, Person Person, string Prompt, string Correct, List<string> Options);

    // Present habitual endings. The subject's gender decides between -तो and -ते for मी and तू.
    private static readonly Person[] Persons =
    {
        new("I (m)",        "मी",     "तो",   "I",        "मी takes -तो when the speaker is male."),
        new("I (f)",        "मी",     "ते",   "I",        "मी takes -ते when the speaker is female."),
        new("You (m, inf)", "तू",     "तोस",  "You",      "तू adds -स on top of the gendered ending."),
        new("You (f, inf)", "तू",     "तेस",  "You",      "तू adds -स on top of the gendered ending."),
        new("He",           "तो",     "तो",   "He",       "Masculine third person → -तो."),
        new("She",          "ती",     "ते",   "She",      "Feminine third person → -ते."),
        new("We",           "आम्ही",  "तो",   "We",       "आम्ही takes -तो regardless of gender."),
        new("You (formal)", "तुम्ही", "ता",   "You",      "तुम्ही → -ता. This is the polite form."),
        new("They",         "ते",     "तात",  "They",     "Plural → -तात."),
    };

    private const string Deck = "verbs";

    private List<Verb> verbs = new();
    private Verb? selected;
    private string tab = "Table";
    private bool isLoading = true;

    private Question? question;
    private bool answered;
    private string chosen = "";
    private int score;
    private readonly Random rng = new();

    protected override async Task OnInitializedAsync()
    {
        verbs = (await Repository.GetAllAsync()).ToList();
        selected = verbs.FirstOrDefault();
        isLoading = false;
    }

    private static string Conjugate(Verb v, Person p) => v.PresentStem + p.Ending;

    private async Task SwitchTab(string t)
    {
        tab = t;
        if (t == "Drill" && question == null) await NextQuestion();
    }

    private async Task NextQuestion()
    {
        if (verbs.Count == 0) return;

        var due = await Srs.GetDueIdsAsync(Deck, verbs.Select(v => v.Id.ToString()), Math.Max(5, verbs.Count / 3));
        var pickId = due.Count > 0 ? due[rng.Next(due.Count)] : verbs[rng.Next(verbs.Count)].Id.ToString();
        var verb = verbs.First(v => v.Id.ToString() == pickId);
        var person = Persons[rng.Next(Persons.Length)];

        var correct = Conjugate(verb, person);
        // Distractors are the same verb under other endings — the confusion that actually matters.
        var opts = Persons.Select(p => Conjugate(verb, p))
                          .Distinct()
                          .Where(f => f != correct)
                          .OrderBy(_ => rng.Next())
                          .Take(3)
                          .Append(correct)
                          .OrderBy(_ => rng.Next())
                          .ToList();

        var prompt = $"{person.EnglishSubject} {StripTo(verb.EnglishTranslation)}";
        question = new Question(verb, person, prompt, correct, opts);
        answered = false;
        chosen = "";
        StateHasChanged();
    }

    private static string StripTo(string infinitive) =>
        infinitive.StartsWith("to ") ? infinitive[3..] : infinitive;

    private string AnswerState(string opt)
    {
        if (!answered) return "";
        if (opt == question!.Correct) return "right";
        return opt == chosen ? "wrong" : "";
    }

    private async Task Answer(string opt)
    {
        if (answered || question == null) return;
        answered = true;
        chosen = opt;
        var correct = opt == question.Correct;
        if (correct) score++;
        await Srs.RecordAsync(Deck, question.Verb.Id.ToString(), correct);
        await Streak.TouchAsync();
        await Speak(question.Person.Subject + " " + question.Correct);
    }

    private async Task Speak(string text) => await JSRuntime.InvokeVoidAsync("speakMarathi", text);
}
