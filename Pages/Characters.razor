@page "/characters"
@using LearnMarathi.Data
@using LearnMarathi.Models
@using LearnMarathi.Services
@using Microsoft.JSInterop
@inject IMarathiCharacterRepository Repository
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISrsService Srs
@inject IStreakService Streak

<PageTitle>Characters · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">
    @if (showQuiz && currentQuestion != null)
    {
        @* ============= QUIZ ============= *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;gap:14px;">
            <span @onclick="CloseQuiz" style="cursor:pointer;display:inline-flex;">
                <Icon Name="x" Size="20" Color="@Theme.Cream" />
            </span>
            <div style="flex:1;height:3px;background:@(Theme.MutedDk + "60");border-radius:2px;position:relative;">
                <div style="position:absolute;left:0;top:0;height:100%;width:@QuizProgressPct%;background:@Theme.Gold;border-radius:2px;"></div>
            </div>
            <span style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;">@correctAnswers/@(correctAnswers + wrongAnswers)</span>
        </div>

        <div style="padding:24px 24px 0;display:flex;align-items:center;justify-content:space-between;gap:12px;">
            <div>
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Question</div>
                <div style="font-family:@Theme.Serif;font-size:22px;color:@Theme.Cream;margin-top:6px;line-height:1.2;letter-spacing:-0.4px;">@currentQuestion.QuestionText</div>
            </div>
            <select @bind="difficultyLevel" @bind:event="onchange"
                    style="background:@Theme.Ink2;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;padding:6px 10px;border-radius:8px;font-family:@Theme.Mono;font-size:11px;">
                <option value="2">2</option>
                <option value="4">4</option>
                <option value="6">6</option>
                <option value="8">8</option>
            </select>
        </div>

        <div style="margin:30px 24px;padding:30px 0;text-align:center;border-top:1px solid @Theme.Gold;border-bottom:1px solid @Theme.Gold;">
            @{ bool charIsMarathi = ContainsDevanagari(currentQuestion.DisplayCharacter); }
            <div style="font-family:@(charIsMarathi ? Theme.Deva : Theme.Serif);font-size:@(charIsMarathi ? 130 : 38)px;color:@Theme.Gold;line-height:1;letter-spacing:@(charIsMarathi ? "0" : "-0.5px");">@currentQuestion.DisplayCharacter</div>
        </div>

        <div style="padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            @{ int li = 0; var letters = new[] { "A","B","C","D","E","F","G","H" }; }
            @foreach (var option in currentQuestion.Options)
            {
                var isCorrectOpt = answerSelected && option == currentQuestion.CorrectAnswer;
                var isPicked = answerSelected && option == selectedAnswer;
                var bg = isCorrectOpt ? Theme.Gold : (isPicked && !isCorrect ? "#5a2828" : "transparent");
                var border = isCorrectOpt ? Theme.Gold : (isPicked && !isCorrect ? "#a04040" : Theme.MutedDk + "80");
                var fg = isCorrectOpt ? Theme.Ink : Theme.Cream;
                var letter = letters[li % letters.Length]; li++;
                var captured = option;
                var optMarathi = ContainsDevanagari(option);
                <button @onclick="() => CheckAnswer(captured)" disabled="@answerSelected"
                        style="padding:18px 16px;border-radius:12px;background:@bg;border:1px solid @border;color:@fg;display:flex;align-items:center;gap:12px;cursor:@(answerSelected ? "default" : "pointer");text-align:left;">
                    <span style="width:26px;height:26px;border-radius:50%;border:1px solid @(isCorrectOpt ? Theme.Ink : Theme.Muted);display:flex;align-items:center;justify-content:center;font-family:@Theme.Mono;font-size:11px;flex-shrink:0;">@letter</span>
                    <span style="font-family:@(optMarathi ? Theme.Deva : Theme.Serif);font-size:@(optMarathi ? 26 : 18)px;letter-spacing:-0.3px;flex:1;">@option</span>
                </button>
            }
        </div>

        @if (answerSelected)
        {
            <div style="margin:24px 24px 0;padding:16px 18px;background:@(isCorrect ? Theme.Gold + "18" : "#5a282818");border-left:2px solid @(isCorrect ? Theme.Gold : "#d96666");border-radius:2px 8px 8px 2px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@(isCorrect ? Theme.Gold : "#d96666");text-transform:uppercase;">@(isCorrect ? "✓ Correct" : "✗ Wrong")</div>
                @if (!isCorrect)
                {
                    <div style="font-family:@Theme.Serif;font-size:16px;color:@Theme.Cream;margin-top:6px;">Answer: <span style="color:@Theme.Gold;">@currentQuestion.CorrectAnswer</span></div>
                }
            </div>
            <QuizNext Visible="true" Label="Continue" OnClick="GenerateNewQuestion" />
        }
    }
    else if (showQuizReview)
    {
        @* ============= QUIZ REVIEW ============= *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
            <span @onclick="CloseReview" style="cursor:pointer;display:inline-flex;">
                <Icon Name="x" Size="20" Color="@Theme.Cream" />
            </span>
            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Results</span>
            <Icon Name="trophy" Size="20" Color="@Theme.Gold" />
        </div>

        <div style="padding:22px 24px 0;">
            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Session complete</div>
            <div style="font-family:@Theme.Serif;font-size:42px;color:@Theme.Cream;margin-top:10px;line-height:1;letter-spacing:-1px;">Well done.</div>
            <div style="font-family:@Theme.Deva;font-size:22px;color:@Theme.Gold;margin-top:8px;">शाबास</div>
        </div>

        <div style="margin:26px 24px 0;padding:22px 0;border-top:1px solid @Theme.Gold;border-bottom:1px solid @Theme.Gold;display:flex;align-items:center;justify-content:space-between;">
            <div>
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Score</div>
                <div style="display:flex;align-items:baseline;gap:4px;margin-top:6px;">
                    <span style="font-family:@Theme.Serif;font-size:64px;color:@Theme.Gold;line-height:0.9;letter-spacing:-2px;">@FinalScorePct</span>
                    <span style="font-family:@Theme.Serif;font-size:24px;color:@Theme.Muted;">%</span>
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-family:@Theme.Serif;font-size:22px;color:@Theme.Cream;">@correctAnswers.ToString("D2")</span>
                    <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;">Correct</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-family:@Theme.Serif;font-size:22px;color:@Theme.MutedDk;">@wrongAnswers.ToString("D2")</span>
                    <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;">Wrong</span>
                </div>
            </div>
        </div>

        var stats = GetCharacterStats();
        var maxAtt = stats.Any() ? stats.Max(s => s.CorrectCount + s.WrongCount) : 1;
        @if (stats.Any())
        {
            <div style="padding:26px 24px 0;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;margin-bottom:16px;">By character</div>
                <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:10px;height:140px;border-bottom:1px solid @(Theme.MutedDk + "50");padding-bottom:6px;">
                    @foreach (var s in stats.Take(8))
                    {
                        var okH = (s.CorrectCount / (double)maxAtt) * 110;
                        var noH = (s.WrongCount / (double)maxAtt) * 110;
                        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
                            <div style="display:flex;flex-direction:column-reverse;width:100%;max-width:32px;">
                                @if (s.CorrectCount > 0)
                                {
                                    <div style="height:@(okH)px;background:@Theme.Gold;border-radius:2px 2px 0 0;"></div>
                                }
                                @if (s.WrongCount > 0)
                                {
                                    <div style="height:@(noH)px;background:@(Theme.MutedDk + "cc");border-top:1px solid @Theme.Ink;"></div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div style="display:flex;justify-content:space-between;gap:10px;margin-top:8px;">
                    @foreach (var s in stats.Take(8))
                    {
                        var pct = s.CorrectCount + s.WrongCount > 0 ? (int)Math.Round(s.CorrectCount * 100.0 / (s.CorrectCount + s.WrongCount)) : 0;
                        var charMarathi = ContainsDevanagari(s.Character);
                        <div style="flex:1;text-align:center;">
                            <div style="font-family:@(charMarathi ? Theme.Deva : Theme.Serif);font-size:22px;color:@Theme.Cream;line-height:1;">@s.Character</div>
                            <div style="font-family:@Theme.Mono;font-size:9px;color:@Theme.Muted;margin-top:4px;">@(pct)%</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div style="padding:22px 24px 6px;display:flex;gap:10px;">
            <span style="display:flex;align-items:center;gap:6px;font-family:@Theme.Mono;font-size:10px;color:@Theme.Muted;letter-spacing:1.5px;text-transform:uppercase;">
                <span style="width:10px;height:10px;background:@Theme.Gold;border-radius:2px;"></span>Correct
            </span>
            <span style="display:flex;align-items:center;gap:6px;font-family:@Theme.Mono;font-size:10px;color:@Theme.Muted;letter-spacing:1.5px;text-transform:uppercase;">
                <span style="width:10px;height:10px;background:@(Theme.MutedDk + "cc");border-radius:2px;"></span>Wrong
            </span>
        </div>

        <div style="padding:22px 24px;display:flex;gap:10px;">
            <button @onclick="RestartQuiz"
                    style="flex:1;padding:14px 16px;border-radius:12px;background:@Theme.Gold;color:@Theme.Ink;border:none;display:flex;align-items:center;justify-content:center;gap:8px;font-family:@Theme.Sans;font-weight:600;font-size:14px;cursor:pointer;">
                Try again <Icon Name="arrow-right" Size="14" Color="@Theme.Ink" />
            </button>
            <button @onclick="BackToLearning"
                    style="flex:1;padding:14px 16px;border-radius:12px;border:1px solid @Theme.Muted;background:transparent;color:@Theme.Cream;font-family:@Theme.Sans;font-weight:500;font-size:14px;cursor:pointer;">
                Back
            </button>
        </div>
    }
    else if (showDrawing && currentDrawingCharacter != null)
    {
        @* ============= DRAWING ============= *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
            <span @onclick="CloseDrawing" style="cursor:pointer;display:inline-flex;">
                <Icon Name="x" Size="20" Color="@Theme.Cream" />
            </span>
            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Practice · @drawingCount.ToString("D2")</span>
            <Icon Name="pencil" Size="18" Color="@Theme.Gold" />
        </div>

        <div style="padding:18px 24px 0;">
            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Trace the character</div>
            <div style="font-family:@Theme.Serif;font-size:24px;color:@Theme.Cream;margin-top:8px;line-height:1.2;letter-spacing:-0.4px;">
                "@currentDrawingCharacter.Pronunciation" — @currentDrawingCharacter.EnglishTranslation
            </div>
        </div>

        <div style="padding:18px 24px 0;display:flex;gap:8px;align-items:center;">
            <span style="font-family:@Theme.Mono;font-size:11px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;">Mode</span>
            <select @bind="drawDifficultyLevel"
                    style="background:@Theme.Ink2;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;padding:6px 10px;border-radius:8px;font-family:@Theme.Mono;font-size:11px;">
                <option value="1">Show character</option>
                <option value="2">Hide character</option>
            </select>
        </div>

        <div style="margin:18px 24px 0;position:relative;border:1px solid @(Theme.MutedDk + "80");border-radius:14px;background-color:@Theme.Ink2;background-image:repeating-linear-gradient(0deg, transparent 0 31px, @(Theme.MutedDk + "25") 31px 32px), repeating-linear-gradient(90deg, transparent 0 31px, @(Theme.MutedDk + "25") 31px 32px);aspect-ratio:1 / 1;display:flex;align-items:center;justify-content:center;overflow:hidden;">
            @if (drawDifficultyLevel == 1)
            {
                <div style="position:absolute;font-family:@Theme.Deva;font-size:200px;color:@Theme.Gold;opacity:0.18;line-height:1;pointer-events:none;">@currentDrawingCharacter.MarathiChar</div>
            }
            <canvas id="signaturePad" width="280" height="280" style="position:relative;z-index:1;width:100%;height:100%;"></canvas>
            <div style="position:absolute;top:12px;left:14px;font-family:@Theme.Mono;font-size:9px;color:@Theme.Muted;letter-spacing:1.5px;">GHOST · @(drawDifficultyLevel == 1 ? "ON" : "OFF")</div>
        </div>

        @if (drawDifficultyLevel == 2 && showGoal)
        {
            <div style="margin:18px 24px 0;padding:14px 16px;background:@(Theme.Gold + "12");border-left:2px solid @Theme.Gold;border-radius:2px 8px 8px 2px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Answer</div>
                <div style="font-family:@Theme.Deva;font-size:48px;color:@Theme.Cream;margin-top:6px;line-height:1;">@currentDrawingCharacter.MarathiChar</div>
            </div>
        }

        <div style="padding:22px 24px 0;display:flex;gap:10px;">
            <button @onclick="ClearCanvas"
                    style="flex:1;padding:12px;border-radius:10px;border:1px solid @(Theme.MutedDk + "80");background:transparent;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:1.5px;color:@Theme.Cream;text-transform:uppercase;cursor:pointer;">Clear</button>
            @if (drawDifficultyLevel == 2)
            {
                <button @onclick="ValidateDrawing"
                        style="flex:1;padding:12px;border-radius:10px;border:1px solid @(Theme.MutedDk + "80");background:transparent;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:1.5px;color:@Theme.Cream;text-transform:uppercase;cursor:pointer;">Show</button>
            }
            <button @onclick="NextCharacter"
                    style="flex:1.4;padding:12px;border-radius:10px;background:@Theme.Gold;color:@Theme.Ink;border:none;text-align:center;font-family:@Theme.Sans;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;">
                Next <Icon Name="arrow-right" Size="14" Color="@Theme.Ink" />
            </button>
        </div>
    }
    else if (showPronunciation && currentPronunciationCharacter != null)
    {
        @* ============= PRONUNCIATION ============= *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
            <span @onclick="ClosePronunciation" style="cursor:pointer;display:inline-flex;">
                <Icon Name="x" Size="20" Color="@Theme.Cream" />
            </span>
            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Pronunciation · @pronunciationCorrect/@(pronunciationCorrect + pronunciationWrong)</span>
            <Icon Name="mic" Size="18" Color="@Theme.Gold" />
        </div>

        <div style="padding:18px 24px 0;">
            <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Gold;text-transform:uppercase;">Say this character</div>
        </div>

        <div style="margin:18px 24px 0;padding:34px 0;text-align:center;border-top:1px solid @Theme.Gold;border-bottom:1px solid @Theme.Gold;cursor:pointer;" @onclick="() => SpeakText(currentPronunciationCharacter.MarathiChar)">
            <div style="font-family:@Theme.Deva;font-size:130px;color:@Theme.Gold;line-height:1;">@currentPronunciationCharacter.MarathiChar</div>
            <div style="font-family:@Theme.Serif;font-size:24px;color:@Theme.Cream;margin-top:14px;letter-spacing:-0.3px;">"@currentPronunciationCharacter.Pronunciation"</div>
            <div style="font-family:@Theme.Sans;font-size:12px;color:@Theme.Muted;margin-top:4px;font-style:italic;">@currentPronunciationCharacter.EnglishTranslation</div>
        </div>

        <div style="display:flex;justify-content:center;margin:32px 0 0;">
            @if (!isRecording)
            {
                <button @onclick="StartRecording"
                        style="width:84px;height:84px;border-radius:50%;background:@Theme.Gold;border:none;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 8px @(Theme.Gold + "25"), 0 0 0 18px @(Theme.Gold + "10");cursor:pointer;">
                    <Icon Name="mic" Size="32" Color="@Theme.Ink" />
                </button>
            }
            else
            {
                <button @onclick="StopRecording"
                        style="width:84px;height:84px;border-radius:50%;background:#d96666;border:none;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 8px #d9666625, 0 0 0 18px #d9666610;cursor:pointer;animation:pulse 1.2s infinite;">
                    <Icon Name="x" Size="32" Color="@Theme.Cream" />
                </button>
            }
        </div>
        <div style="text-align:center;margin-top:14px;font-family:@Theme.Serif;font-size:16px;color:@Theme.Cream;">
            @(isRecording ? "Recording…" : (isProcessingRecording ? "Processing…" : "Tap to record"))
        </div>

        @if (!string.IsNullOrEmpty(pronunciationFeedback))
        {
            var ok = pronunciationFeedbackClass == "validation-correct";
            <div style="margin:26px 24px 0;padding:16px 18px;border:1px solid @(ok ? Theme.Gold : "#d96666" + "60");background:@(ok ? Theme.Gold + "12" : "#5a282818");border-radius:12px;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                    <div>
                        <div style="font-family:@Theme.Mono;font-size:9px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;">You said</div>
                        <div style="font-family:@Theme.Serif;font-size:20px;color:@Theme.Cream;margin-top:4px;">@(string.IsNullOrEmpty(recognizedText) ? "—" : recognizedText)</div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <Icon Name="@(ok ? "check" : "x")" Size="16" Color="@(ok ? Theme.Gold : "#d96666")" />
                        <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:1.5px;color:@(ok ? Theme.Gold : "#d96666");text-transform:uppercase;">@(ok ? "Match" : "Try again")</span>
                    </div>
                </div>
                <div style="font-family:@Theme.Sans;font-size:12px;color:@Theme.Muted;margin-top:8px;line-height:1.5;">@pronunciationFeedback</div>
            </div>
        }

        <div style="padding:24px;">
            <button @onclick="NextPronunciationCharacter"
                    style="width:100%;background:transparent;border:1px solid @(Theme.MutedDk + "80");color:@Theme.Cream;padding:14px;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:8px;font-family:@Theme.Sans;font-weight:500;font-size:14px;cursor:pointer;">
                Next character <Icon Name="arrow-right" Size="14" Color="@Theme.Cream" />
            </button>
        </div>
    }
    else
    {
        @* ============= LIST ============= *@
        <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
            <span @onclick='() => NavigateToPage("/")' style="cursor:pointer;display:inline-flex;">
                <Icon Name="arrow-left" Size="20" Color="@Theme.Cream" />
            </span>
            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Lesson 01</span>
            <Icon Name="target" Size="20" Color="@Theme.Gold" />
        </div>

        <div style="padding:18px 24px 6px;">
            <div style="font-family:@Theme.Serif;font-size:36px;line-height:1;color:@Theme.Cream;letter-spacing:-1px;">Characters</div>
            <div style="font-family:@Theme.Deva;font-size:24px;color:@Theme.Gold;margin-top:6px;">देवनागरी</div>
            <div style="font-family:@Theme.Sans;font-size:13px;color:@Theme.Muted;margin-top:10px;line-height:1.5;">The Devanagari script — foundation of reading and writing Marathi.</div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="margin:18px 24px;padding:16px;background:#5a282818;border-left:2px solid #d96666;border-radius:2px 8px 8px 2px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:#d96666;text-transform:uppercase;">Error</div>
                <div style="font-family:@Theme.Sans;font-size:13px;color:@Theme.Cream;margin-top:4px;">@errorMessage</div>
            </div>
        }

        @if (isLoading)
        {
            <div style="padding:40px 24px;text-align:center;font-family:@Theme.Mono;font-size:11px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">Loading…</div>
        }
        else if (characters.Any())
        {
            @* Tabs *@
            <div style="display:flex;gap:24px;padding:18px 24px;border-bottom:1px solid @(Theme.MutedDk + "40");">
                @{ var tabs = new[] { "All", "Vowel", "Consonant" }; }
                @foreach (var t in tabs)
                {
                    var active = selectedType == t;
                    var captured = t;
                    <span @onclick="() => FilterByType(captured)"
                          style="font-family:@Theme.Sans;font-size:13px;font-weight:@(active ? "600" : "400");color:@(active ? Theme.Cream : Theme.Muted);padding-bottom:10px;border-bottom:@(active ? "2px solid " + Theme.Gold : "2px solid transparent");cursor:pointer;">
                        @(t == "Vowel" ? "Vowels" : (t == "Consonant" ? "Consonants" : "All"))
                    </span>
                }
            </div>

            var displayChars = filteredCharacters.ToList();
            var label = selectedType == "Vowel" ? "स्वर — Vowels" : (selectedType == "Consonant" ? "व्यंजन — Consonants" : "अक्षरे — All");
            <div style="padding:20px 24px 0;font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">@label · @displayChars.Count</div>

            <div style="padding:14px 24px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                @{ int ci = 0; }
                @foreach (var character in displayChars)
                {
                    ci++;
                    var ch = character;
                    <div style="background:@Theme.Ink2;border-radius:14px;padding:18px 16px;border:1px solid @(Theme.MutedDk + "30");position:relative;">
                        <div style="position:absolute;top:10px;right:12px;font-family:@Theme.Mono;font-size:9px;color:@Theme.MutedDk;">@ci.ToString("D2")</div>
                        <div style="font-family:@Theme.Deva;font-size:54px;color:@Theme.Gold;line-height:1;margin-top:4px;">@ch.MarathiChar</div>
                        <div style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Cream;margin-top:14px;">@ch.EnglishTranslation</div>
                        <div style="font-family:@Theme.Sans;font-size:11px;color:@Theme.Muted;margin-top:4px;font-style:italic;">@ch.Pronunciation</div>
                        <div @onclick="() => SpeakText(ch.MarathiChar)" style="display:flex;align-items:center;gap:6px;margin-top:14px;color:@Theme.Gold;cursor:pointer;">
                            <Icon Name="speaker" Size="14" Color="@Theme.Gold" />
                            <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:1px;text-transform:uppercase;">Listen</span>
                        </div>
                    </div>
                }
            </div>

            @* Practice modes *@
            <div style="padding:24px;margin-top:8px;">
                <div style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;margin-bottom:14px;">Practice</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <div @onclick="StartQuiz" style="display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid @(Theme.MutedDk + "40");border-radius:12px;cursor:pointer;">
                        <Icon Name="target" Size="18" Color="@Theme.Gold" />
                        <span style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Cream;flex:1;">Multiple choice quiz</span>
                        <Icon Name="arrow-right" Size="16" Color="@Theme.Muted" />
                    </div>
                    <div @onclick="StartDrawing" style="display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid @(Theme.MutedDk + "40");border-radius:12px;cursor:pointer;">
                        <Icon Name="pencil" Size="18" Color="@Theme.Gold" />
                        <span style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Cream;flex:1;">Drawing practice</span>
                        <Icon Name="arrow-right" Size="16" Color="@Theme.Muted" />
                    </div>
                    <div @onclick="StartPronunciation" style="display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid @(Theme.MutedDk + "40");border-radius:12px;cursor:pointer;">
                        <Icon Name="mic" Size="18" Color="@Theme.Gold" />
                        <span style="font-family:@Theme.Serif;font-size:18px;color:@Theme.Cream;flex:1;">Pronunciation</span>
                        <Icon Name="arrow-right" Size="16" Color="@Theme.Muted" />
                    </div>
                </div>
            </div>
        }
    }

    <NavBar />
</div>

<style>
    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    canvas#signaturePad { touch-action: none; background: transparent; }
</style>

@code {
    private IEnumerable<MarathiCharacter> characters = new List<MarathiCharacter>();
    private IEnumerable<MarathiCharacter> filteredCharacters = new List<MarathiCharacter>();
    private string selectedType = "All";
    private bool isLoading = true;
    private string errorMessage = "";

    // Quiz variables
    private bool showQuiz = false;
    private bool showQuizReview = false;
    private QuizQuestion? currentQuestion = null;
    private int difficultyLevel = 4;
    private int drawDifficultyLevel = 1;
    private int correctAnswers = 0;
    private int wrongAnswers = 0;
    private bool answerSelected = false;
    private bool isCorrect = false;
    private string selectedAnswer = "";
    private Random random = new Random();
    private List<string> correctAnswersAggregate = new List<string>();
    private List<string> wrongAnswersAggregate = new List<string>();

    // Drawing variables
    private bool showDrawing = false;
    private MarathiCharacter? currentDrawingCharacter = null;
    private int drawingCount = 0;
    private bool showGoal = false;

    // Pronunciation variables
    private bool showPronunciation = false;
    private MarathiCharacter? currentPronunciationCharacter = null;
    private int pronunciationCorrect = 0;
    private int pronunciationWrong = 0;
    private bool isRecording = false;
    private bool isProcessingRecording = false;
    private string pronunciationFeedback = "";
    private string pronunciationFeedbackClass = "";
    private string recognizedText = "";

    private int QuizProgressPct
    {
        get
        {
            var total = correctAnswers + wrongAnswers;
            if (total == 0) return 0;
            return Math.Min(100, (int)(total * 100.0 / 20));
        }
    }

    private int FinalScorePct
    {
        get
        {
            var total = correctAnswers + wrongAnswers;
            if (total == 0) return 0;
            return (int)Math.Round(correctAnswers * 100.0 / total);
        }
    }

    private static bool ContainsDevanagari(string s)
    {
        if (string.IsNullOrEmpty(s)) return false;
        foreach (var ch in s) if (ch >= 0x0900 && ch <= 0x097F) return true;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Repository == null)
            {
                errorMessage = "Repository is not initialized!";
                isLoading = false;
                return;
            }

            characters = await Repository.GetAllCharactersAsync();
            filteredCharacters = characters;

            if (characters == null || !characters.Any())
            {
                errorMessage = "No characters found in database. Please run the SQL setup script.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading characters: {ex.Message}";
            Console.WriteLine($"Full error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByType(string type)
    {
        selectedType = type;
        if (type == "All")
        {
            filteredCharacters = characters;
        }
        else
        {
            filteredCharacters = characters.Where(c => c.CharacterType == type);
        }
    }

    private void NavigateToPage(string url)
    {
        NavigationManager.NavigateTo(url);
    }

    private const string SrsDeckChars = "characters";
    private int currentCorrectId;

    private async Task StartQuiz()
    {
        showQuiz = true;
        showQuizReview = false;
        correctAnswers = 0;
        wrongAnswers = 0;
        correctAnswersAggregate = new List<string>();
        wrongAnswersAggregate = new List<string>();
        await GenerateNewQuestion();
    }

    private void CloseQuiz()
    {
        showQuiz = false;
        showQuizReview = true;
        currentQuestion = null;
        answerSelected = false;
    }

    private async Task GenerateNewQuestion()
    {
        if (!characters.Any()) return;

        answerSelected = false;
        isCorrect = false;
        selectedAnswer = "";

        bool askMarathiToEnglish = random.Next(2) == 0;

        var charactersList = characters.ToList();
        var allIds = charactersList.Select(c => c.Id.ToString()).ToList();
        var prioritizedIds = await Srs.GetDueIdsAsync(SrsDeckChars, allIds, Math.Max(5, charactersList.Count / 4));
        MarathiCharacter correctChar;
        if (prioritizedIds.Count > 0)
        {
            var pickedId = prioritizedIds[random.Next(prioritizedIds.Count)];
            correctChar = charactersList.FirstOrDefault(c => c.Id.ToString() == pickedId)
                ?? charactersList[random.Next(charactersList.Count)];
        }
        else
        {
            correctChar = charactersList[random.Next(charactersList.Count)];
        }
        currentCorrectId = correctChar.Id;

        var wrongOptions = charactersList
            .Where(c => c.Id != correctChar.Id)
            .OrderBy(x => random.Next())
            .Take(difficultyLevel - 1)
            .ToList();

        var allOptions = new List<string>();

        if (askMarathiToEnglish)
        {
            allOptions.Add(correctChar.EnglishTranslation);
            allOptions.AddRange(wrongOptions.Select(c => c.EnglishTranslation));

            currentQuestion = new QuizQuestion
            {
                QuestionText = "What is the English transliteration?",
                DisplayCharacter = correctChar.MarathiChar,
                CorrectAnswer = correctChar.EnglishTranslation,
                Options = allOptions.OrderBy(x => random.Next()).ToList()
            };
        }
        else
        {
            allOptions.Add(correctChar.MarathiChar);
            allOptions.AddRange(wrongOptions.Select(c => c.MarathiChar));

            currentQuestion = new QuizQuestion
            {
                QuestionText = "Which Marathi character represents this?",
                DisplayCharacter = correctChar.EnglishTranslation,
                CorrectAnswer = correctChar.MarathiChar,
                Options = allOptions.OrderBy(x => random.Next()).ToList()
            };
        }
    }

    private async Task CheckAnswer(string answer)
    {
        if (answerSelected || currentQuestion == null) return;

        answerSelected = true;
        selectedAnswer = answer;
        isCorrect = answer == currentQuestion.CorrectAnswer;

        if (isCorrect)
        {
            correctAnswersAggregate.Add(answer);
            correctAnswers++;
        }
        else
        {
            wrongAnswersAggregate.Add(currentQuestion.CorrectAnswer);
            wrongAnswers++;
        }

        await Srs.RecordAsync(SrsDeckChars, currentCorrectId.ToString(), isCorrect);
        await Streak.TouchAsync();

        if (!isCorrect) return;
        var answeredQuestion = currentQuestion;
        await Task.Delay(QuizNext.AutoAdvanceMs);
        if (currentQuestion == answeredQuestion && answerSelected) await GenerateNewQuestion();
    }

    private string GetOptionClass(string option)
    {
        if (!answerSelected) return "";
        if (option == currentQuestion?.CorrectAnswer) return "correct";
        if (option == selectedAnswer && !isCorrect) return "wrong";
        return "";
    }

    private List<CharacterStat> GetCharacterStats()
    {
        var stats = new Dictionary<string, CharacterStat>();
        foreach (var answer in correctAnswersAggregate)
        {
            if (!stats.ContainsKey(answer)) stats[answer] = new CharacterStat { Character = answer };
            stats[answer].CorrectCount++;
        }
        foreach (var answer in wrongAnswersAggregate)
        {
            if (!stats.ContainsKey(answer)) stats[answer] = new CharacterStat { Character = answer };
            stats[answer].WrongCount++;
        }
        return stats.Values
            .OrderByDescending(s => s.CorrectCount + s.WrongCount)
            .ThenByDescending(s => s.CorrectCount)
            .ToList();
    }

    private void CloseReview()
    {
        showQuizReview = false;
        correctAnswersAggregate.Clear();
        wrongAnswersAggregate.Clear();
    }

    private async Task RestartQuiz()
    {
        showQuizReview = false;
        await StartQuiz();
    }

    private void BackToLearning()
    {
        showQuizReview = false;
        correctAnswersAggregate.Clear();
        wrongAnswersAggregate.Clear();
    }

    // Drawing
    private async Task StartDrawing()
    {
        showDrawing = true;
        drawingCount = 0;
        SelectRandomCharacter();
        await Task.Delay(100);
        await InitializeSignaturePad();
    }

    private void CloseDrawing()
    {
        showDrawing = false;
        currentDrawingCharacter = null;
        drawingCount = 0;
    }

    private void SelectRandomCharacter()
    {
        if (!characters.Any()) return;
        var charactersList = characters.ToList();
        currentDrawingCharacter = charactersList[random.Next(charactersList.Count)];
    }

    private async Task NextCharacter()
    {
        drawingCount++;
        SelectRandomCharacter();
        showGoal = false;
        await ClearCanvas();
    }

    private async Task ClearCanvas()
    {
        await JSRuntime.InvokeVoidAsync("clearSignaturePad");
    }

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await JSRuntime.InvokeVoidAsync("speakMarathi", text);
    }

    private async Task InitializeSignaturePad()
    {
        await JSRuntime.InvokeVoidAsync("initSignaturePad");
    }

    private void ValidateDrawing()
    {
        if (currentDrawingCharacter == null) return;
        showGoal = true;
        StateHasChanged();
    }

    // Pronunciation
    private void StartPronunciation()
    {
        showPronunciation = true;
        pronunciationCorrect = 0;
        pronunciationWrong = 0;
        SelectRandomPronunciationCharacter();
    }

    private void ClosePronunciation()
    {
        showPronunciation = false;
        currentPronunciationCharacter = null;
        pronunciationCorrect = 0;
        pronunciationWrong = 0;
        pronunciationFeedback = "";
        recognizedText = "";
    }

    private void SelectRandomPronunciationCharacter()
    {
        if (!characters.Any()) return;
        var charactersList = characters.ToList();
        currentPronunciationCharacter = charactersList[random.Next(charactersList.Count)];
        pronunciationFeedback = "";
        recognizedText = "";
        pronunciationFeedbackClass = "";
    }

    private async Task NextPronunciationCharacter()
    {
        SelectRandomPronunciationCharacter();
        await Task.CompletedTask;
    }

    private async Task StartRecording()
    {
        try
        {
            isRecording = true;
            pronunciationFeedback = "";
            await JSRuntime.InvokeVoidAsync("startVoiceRecording");
        }
        catch (Exception ex)
        {
            pronunciationFeedback = $"Error starting recording: {ex.Message}";
            pronunciationFeedbackClass = "validation-wrong";
            isRecording = false;
        }
    }

    private async Task StopRecording()
    {
        try
        {
            isRecording = false;
            isProcessingRecording = true;
            StateHasChanged();

            var result = await JSRuntime.InvokeAsync<SpeechRecognitionResult>("stopVoiceRecording");
            isProcessingRecording = false;

            if (result?.Success == true && !string.IsNullOrEmpty(result.Text))
            {
                recognizedText = result.Text;
                var expectedPronunciation = currentPronunciationCharacter?.Pronunciation ?? "";
                var expectedEnglish = currentPronunciationCharacter?.EnglishTranslation ?? "";

                bool ok = ValidatePronunciation(result.Text, expectedEnglish);

                if (ok)
                {
                    pronunciationCorrect++;
                    pronunciationFeedback = $"Recognized: '{result.Text}' (Confidence: {result.Confidence:P0})";
                    pronunciationFeedbackClass = "validation-correct";
                }
                else
                {
                    pronunciationWrong++;
                    pronunciationFeedback = $"Heard: '{result.Text}', Expected: '{expectedPronunciation}'";
                    pronunciationFeedbackClass = "validation-wrong";
                }
            }
            else
            {
                isProcessingRecording = false;
                pronunciationFeedback = result?.Message ?? "Could not recognize speech.";
                pronunciationFeedbackClass = "validation-wrong";
                recognizedText = "Not recognized";
            }
        }
        catch (Exception ex)
        {
            pronunciationFeedback = $"Error: {ex.Message}";
            pronunciationFeedbackClass = "validation-wrong";
            isRecording = false;
            isProcessingRecording = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private bool ValidatePronunciation(string recognizedText, string expectedText)
    {
        if (string.IsNullOrEmpty(recognizedText) || string.IsNullOrEmpty(expectedText)) return false;

        var recognized = recognizedText.ToLower().Trim();
        var expected = expectedText.ToLower().Trim();

        if (recognized == expected) return true;
        if (recognized.Contains(expected) || expected.Contains(recognized)) return true;

        var phoneticMappings = new Dictionary<string, string[]>
        {
            { "a", new[] { "aa", "ah", "uh", "आ", "अ" } },
            { "aa", new[] { "a", "ah", "आ", "अ" } },
            { "i", new[] { "ee", "ई", "इ" } },
            { "ee", new[] { "i", "ई", "इ" } },
            { "u", new[] { "oo", "ऊ", "उ" } },
            { "oo", new[] { "u", "ऊ", "उ" } },
            { "e", new[] { "ay", "ए", "ऐ" } },
            { "o", new[] { "oh", "ओ", "औ" } },
            { "ka", new[] { "क", "kaa", "kah" } },
            { "kha", new[] { "ख", "khaa", "khah" } },
            { "ga", new[] { "ग", "gaa", "gah" } },
            { "gha", new[] { "घ", "ghaa", "ghah" } },
            { "cha", new[] { "च", "chaa", "chah" } },
            { "ja", new[] { "ज", "jaa", "jah" } },
            { "ta", new[] { "त", "taa", "tah" } },
            { "da", new[] { "द", "daa", "dah" } },
            { "na", new[] { "न", "naa", "nah" } },
            { "pa", new[] { "प", "paa", "pah" } },
            { "ba", new[] { "ब", "baa", "bah" } },
            { "ma", new[] { "म", "maa", "mah" } },
            { "ya", new[] { "य", "yaa", "yah" } },
            { "ra", new[] { "र", "raa", "rah" } },
            { "la", new[] { "ल", "laa", "lah" } },
            { "va", new[] { "व", "vaa", "vah", "wa" } },
            { "sa", new[] { "स", "saa", "sah" } },
            { "ha", new[] { "ह", "haa", "hah", "हाँ", "हा" } },
        };

        foreach (var mapping in phoneticMappings)
        {
            if (expected.Contains(mapping.Key))
            {
                foreach (var variant in mapping.Value)
                {
                    if (recognized.Contains(variant)) return true;
                }
            }
        }

        int distance = LevenshteinDistance(recognized, expected);
        int maxLength = Math.Max(recognized.Length, expected.Length);
        double similarity = 1.0 - ((double)distance / maxLength);

        if (maxLength <= 3 && similarity >= 0.4) return true;
        if (similarity >= 0.6) return true;
        if (expected.Length <= 2 && recognized.Length > 0 && expected[0] == recognized[0]) return true;

        return false;
    }

    private int LevenshteinDistance(string s1, string s2)
    {
        if (string.IsNullOrEmpty(s1)) return s2?.Length ?? 0;
        if (string.IsNullOrEmpty(s2)) return s1.Length;

        int[,] d = new int[s1.Length + 1, s2.Length + 1];
        for (int i = 0; i <= s1.Length; i++) d[i, 0] = i;
        for (int j = 0; j <= s2.Length; j++) d[0, j] = j;

        for (int i = 1; i <= s1.Length; i++)
        {
            for (int j = 1; j <= s2.Length; j++)
            {
                int cost = (s1[i - 1] == s2[j - 1]) ? 0 : 1;
                d[i, j] = Math.Min(Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1), d[i - 1, j - 1] + cost);
            }
        }
        return d[s1.Length, s2.Length];
    }

    private class SpeechRecognitionResult
    {
        public bool Success { get; set; }
        public string? Text { get; set; }
        public double Confidence { get; set; }
        public string? Message { get; set; }
    }

    private class QuizQuestion
    {
        public string QuestionText { get; set; } = "";
        public string DisplayCharacter { get; set; } = "";
        public string CorrectAnswer { get; set; } = "";
        public List<string> Options { get; set; } = new();
    }

    private class CharacterStat
    {
        public string Character { get; set; } = "";
        public int CorrectCount { get; set; }
        public int WrongCount { get; set; }
    }
}
