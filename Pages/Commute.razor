@page "/commute"
@using LearnMarathi.Models
@using LearnMarathi.Services
@implements IDisposable
@inject CommutePlayer Player
@inject ISrsService Srs
@inject IJSRuntime JSRuntime

<PageTitle>Commute · Learn Marathi</PageTitle>

<div style="min-height:100vh;background:@Theme.Ink;color:@Theme.Cream;font-family:@Theme.Sans;padding:24px 0 32px;">

    @if (!showPlayer || episode == null)
    {
        <PageHead Title="Commute" Marathi="प्रवास" Eyebrow="Listening" Glyph="headphones"
                  Blurb="Guided episodes for the train. Each one plays the conversation, walks through it line by line with the English, then plays it again. Pocket the phone and listen." />

        @if (isLoading)
        {
            <div style="padding:18px 24px 0;display:grid;gap:14px;">
                <div class="skeleton" style="height:50px;border-radius:100px;"></div>
                @for (var i = 0; i < 5; i++)
                {
                    <div class="skeleton" style="height:56px;"></div>
                }
            </div>
        }
        else
        {
            <div style="margin:18px 24px 0;padding:12px 14px;border:1px solid @(Theme.Gold + "50");border-radius:12px;background:@(Theme.Gold + "12");">
                <div class="eyebrow" style="color:@Theme.Gold;">Unverified</div>
                <div style="font-size:12px;color:@Theme.Muted;line-height:1.6;margin-top:6px;">
                    These scripts have not been checked by a native speaker yet. They should be natural, but treat odd phrasing with suspicion.
                </div>
            </div>

            <div @onclick="PlayAll" class="btn btn-primary" style="margin:18px 24px 0;">
                <Icon Name="play" Size="16" Color="@Theme.Ink" /> Play all unheard
            </div>

            @foreach (var group in Player.Episodes.GroupBy(e => e.Topic))
            {
                <div style="padding:26px 24px 0;">
                    <div class="eyebrow" style="margin-bottom:6px;">@TopicLabel(group.Key)</div>
                    @foreach (var ep in group)
                    {
                        var done = Player.Listened.Contains(ep.Id);
                        var nowPlaying = Player.Episode?.Id == ep.Id;
                        <div @onclick="() => Open(ep)" class="row" style="cursor:pointer;">
                            <div style="width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:1px solid @(done || nowPlaying ? Theme.Gold : Theme.MutedDk + "80");background:@(done ? Theme.Gold : "transparent");">
                                <Icon Name="@(nowPlaying && Player.Playing ? "pause" : done ? "check" : "play")" Size="14" Color="@(done ? Theme.Ink : nowPlaying ? Theme.Gold : Theme.Cream)" />
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-family:@Theme.Serif;font-size:19px;color:@(nowPlaying ? Theme.Gold : Theme.Cream);line-height:1.2;">@ep.Title</div>
                                <div style="font-family:@Theme.Deva;font-size:15px;color:@Theme.Gold;margin-top:2px;">@ep.MarathiTitle</div>
                            </div>
                            <div style="text-align:right;flex-shrink:0;font-family:@Theme.Mono;font-size:10px;color:@Theme.Muted;line-height:1.7;">
                                <div>@LevelLabel(ep.Level)</div>
                                @if (Player.Positions.TryGetValue(ep.Id, out var at))
                                {
                                    <div style="color:@Theme.Gold;">Resume @FormatTime(at)</div>
                                }
                                else if (Player.Durations.TryGetValue(ep.Id, out var d))
                                {
                                    <div>@FormatTime(d)</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
    else
    {
        <PageHead Title="Commute" Marathi="प्रवास" Glyph="headphones" Compact="true" OnBack="ShowList" />

        <div style="padding:20px 24px 0;">
            <div class="eyebrow">@TopicLabel(episode.Topic) · @Player.PhaseLabel</div>
            <div style="font-family:@Theme.Serif;font-size:26px;color:@Theme.Cream;margin-top:8px;line-height:1.15;">@episode.Title</div>
            <div style="font-family:@Theme.Deva;font-size:18px;color:@Theme.Gold;margin-top:4px;">@episode.MarathiTitle</div>
        </div>

        @if (Player.Timing == null)
        {
            <div style="margin:24px;font-size:13px;color:@Theme.Muted;">Audio for this episode has not been built yet.</div>
        }
        else
        {
            var timing = Player.Timing;
            @* Sticky so the controls stay reachable while the transcript scrolls underneath. *@
            <div style="position:sticky;top:0;z-index:5;background:@Theme.Ink;padding:16px 24px 14px;border-bottom:1px solid var(--line);">
                <input type="range" min="0" max="@((int)timing.Duration)" step="1" value="@((int)Player.Position)"
                       @onchange="SeekFromSlider" style="width:100%;accent-color:@Theme.Gold;" />
                <div style="display:flex;justify-content:space-between;font-family:@Theme.Mono;font-size:10px;color:@Theme.Muted;">
                    <span>@FormatTime(Player.Position)</span><span>@FormatTime(timing.Duration)</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:center;gap:28px;margin-top:10px;">
                    <div @onclick="() => Player.SkipAsync(-10)" class="tap" style="flex-direction:column;gap:2px;">
                        <Icon Name="rewind" Size="24" Color="@Theme.Cream" />
                        <span style="font-family:@Theme.Mono;font-size:9px;color:@Theme.Muted;">10s</span>
                    </div>
                    <div @onclick="Player.TogglePlayAsync" class="btn-gold anim-pop" @key="Player.Playing"
                         style="width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;">
                        <Icon Name="@(Player.Playing ? "pause" : "play")" Size="26" Color="@Theme.Ink" Stroke="2.6" />
                    </div>
                    <div @onclick="Player.ToggleRateAsync" class="chip @(Player.Rate < 1 ? "is-active" : "")" style="font-family:@Theme.Mono;">@(Player.Rate < 1 ? "0.75×" : "1×")</div>
                </div>
            </div>

            <div style="display:flex;gap:8px;padding:14px 24px 4px;">
                <span @onclick="() => showRoman = !showRoman" class="chip @(showRoman ? "is-active" : "")">Romanised</span>
                <span @onclick="() => showEnglish = !showEnglish" class="chip @(showEnglish ? "is-active" : "")">English</span>
                <span @onclick="() => Player.AutoNext = !Player.AutoNext" class="chip @(Player.AutoNext ? "is-active" : "")">Auto-next</span>
                <span @onclick="Player.ToggleBlindAsync" class="chip @(Player.Blind ? "is-active" : "")">Blind</span>
            </div>

            @if (BlindHidden)
            {
                @QuestionsView
                <div style="margin:24px 24px 0;padding:22px 18px;text-align:center;" class="card">
                    <WarliDancers Count="3" Opacity="0.45" />
                    <div style="font-size:13px;color:@Theme.Muted;line-height:1.7;margin-top:14px;">
                        Transcript hidden. Answer the questions from what you heard and it appears.
                    </div>
                    <div @onclick="() => revealed = true" class="btn btn-ghost" style="margin-top:14px;min-height:42px;font-size:13px;">Show it now</div>
                </div>
            }
            else
            {
                @TranscriptView
                @QuestionsView
            }

            <div style="padding:28px 24px 8px;">
                <div class="eyebrow">Key words</div>
                @foreach (var v in episode.Vocab)
                {
                    <div @onclick="() => Speak(v.Marathi)" class="row" style="align-items:baseline;gap:10px;cursor:pointer;flex-wrap:wrap;padding:10px 0;">
                        <span style="font-family:@Theme.Deva;font-size:19px;color:@Theme.Cream;">@v.Marathi</span>
                        <span style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;">@v.Roman</span>
                        <span style="font-size:13px;color:@Theme.Muted;margin-left:auto;">@v.English</span>
                        <StarButton Marathi="@v.Marathi" Size="16" />
                    </div>
                }
                <div @onclick="AddVocabToReview" class="btn @(vocabAdded ? "btn-ghost" : "btn-primary")"
                     style="margin-top:18px;@(vocabAdded ? $"color:{Theme.Gold};border-color:{Theme.Gold};cursor:default;" : "")">
                    @(vocabAdded ? "Added to Review" : "Add these words to Review")
                </div>
            </div>
        }
    }

    <NavBar />
</div>

@code {
    public const string Deck = "commute";

    [Parameter, SupplyParameterFromQuery(Name = "player")] public bool OpenPlayer { get; set; }

    private bool isLoading = true;
    private bool showPlayer;
    private CommuteEpisode? episode => Player.Episode;
    private int scrolledToLine = -1;
    private bool showRoman = true;
    private bool showEnglish;
    private bool vocabAdded;
    private bool revealed;
    private Dictionary<int, int> answers = new();
    private string? answersFor;

    protected override async Task OnInitializedAsync()
    {
        Player.Changed += OnPlayerChanged;
        await Player.InitAsync();
        isLoading = false;
    }

    // Arriving from the mini player (?player=true) goes straight to the episode that is playing.
    protected override void OnParametersSet()
    {
        if (OpenPlayer && Player.Episode != null) SetPlayerVisible(true);
    }

    private async Task Open(CommuteEpisode ep)
    {
        await Player.OpenAsync(ep);
        SetPlayerVisible(true);
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private async Task PlayAll()
    {
        await Player.PlayAllAsync();
        SetPlayerVisible(true);
    }

    private void ShowList() => SetPlayerVisible(false);

    private void SetPlayerVisible(bool visible)
    {
        showPlayer = visible;
        Player.FullPlayerVisible = visible;
        if (visible && answersFor != Player.Episode?.Id)
        {
            answersFor = Player.Episode?.Id;
            answers = new();
            vocabAdded = false;
            revealed = false;
            scrolledToLine = -1;
        }
    }

    private async void OnPlayerChanged()
    {
        // Auto-next swaps the episode under us; reset the per-episode questions.
        if (showPlayer && answersFor != Player.Episode?.Id) SetPlayerVisible(true);

        var line = Player.CurrentLine;
        if (showPlayer && Player.Playing && line >= 0 && line != scrolledToLine)
        {
            scrolledToLine = line;
            await JSRuntime.InvokeVoidAsync("lmScrollIntoView", $"line-{line}");
        }
        await InvokeAsync(StateHasChanged);
    }

    // Hidden until every question is answered (or the learner gives up), so the questions test the ear alone.
    private bool BlindHidden => Player.Blind && !revealed && episode != null && answers.Count < episode.Questions.Count;

    private RenderFragment TranscriptView => __builder =>
    {
        <div style="padding:6px 24px 0;">
            @for (var i = 0; i < episode!.Lines.Count; i++)
            {
                var idx = i;
                var line = episode.Lines[i];
                var current = Player.CurrentLine;
                var active = current == i;
                <div id="line-@i" @onclick="() => JumpToLine(idx)"
                     style="padding:12px 0 12px 14px;border-left:2px solid @(active ? Theme.Gold : "transparent");cursor:pointer;opacity:@(current < 0 || active ? "1" : "0.6");transition:opacity .3s, border-color .3s;">
                    <div style="font-family:@Theme.Mono;font-size:9px;letter-spacing:1.5px;color:@Theme.Muted;text-transform:uppercase;">@SpeakerName(line.Speaker)</div>
                    <div style="font-family:@Theme.Deva;font-size:20px;color:@(active ? Theme.Gold : Theme.Cream);line-height:1.5;margin-top:2px;transition:color .3s;">@line.Marathi</div>
                    @if (showRoman)
                    {
                        <div style="font-family:@Theme.Mono;font-size:11px;color:@Theme.Muted;font-style:italic;margin-top:2px;">@line.Roman</div>
                    }
                    @if (showEnglish)
                    {
                        <div style="font-size:13px;color:@Theme.Muted;margin-top:3px;">@line.English</div>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment QuestionsView => __builder =>
    {
        <div style="padding:28px 24px 0;">
            <div class="eyebrow">Check yourself</div>
            @for (var q = 0; q < episode!.Questions.Count; q++)
            {
                var qi = q;
                var question = episode.Questions[q];
                <div style="margin-top:14px;">
                    <div style="font-size:14px;color:@Theme.Cream;line-height:1.5;">@question.Question</div>
                    <div style="display:grid;gap:8px;margin-top:10px;">
                        @for (var o = 0; o < question.Options.Count; o++)
                        {
                            var oi = o;
                            var picked = answers.TryGetValue(qi, out var a) ? a : -1;
                            var state = picked < 0 ? "" : oi == question.Answer ? "right" : oi == picked ? "wrong" : "";
                            <div @onclick="() => AnswerQuestion(qi, oi)" class="option @(state == "right" ? "is-right" : state == "wrong" ? "is-wrong" : "")"
                                 style="padding:12px 14px;border-radius:12px;text-align:left;font-size:13px;">@question.Options[o]</div>
                        }
                    </div>
                </div>
            }
        </div>
    };

    private async Task SeekFromSlider(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var t)) await Player.SeekAsync(t);
    }

    /// <summary>Tapping a line jumps to its line-by-line teaching segment, the most useful place to replay.</summary>
    private async Task JumpToLine(int line)
    {
        var seg = Player.Timing?.Segments.FirstOrDefault(s => s.Line == line && s.Phase == "slow");
        if (seg == null) return;
        await Player.SeekAsync(seg.T);
        if (!Player.Playing) await Player.PlayAsync();
    }

    private async Task AnswerQuestion(int question, int option)
    {
        if (answers.ContainsKey(question) || episode == null) return;
        answers[question] = option;
        await JSRuntime.InvokeVoidAsync("lmHaptic", option == episode.Questions[question].Answer ? "success" : "error");
    }

    private async Task AddVocabToReview()
    {
        if (episode == null || vocabAdded) return;
        foreach (var v in episode.Vocab)
        {
            var card = await Srs.GetAsync(Deck, v.Marathi);
            // A first correct rep, so each word comes up as a normal Review question from tomorrow.
            if (card.Reps == 0) await Srs.RecordAsync(Deck, v.Marathi, true);
        }
        vocabAdded = true;
    }

    private string SpeakerName(string key) =>
        episode != null && episode.Speakers.TryGetValue(key, out var s) ? s.Name : key;

    private static string LevelLabel(int level) => level switch { 1 => "Easy", 3 => "Story", _ => "Everyday" };

    public static string TopicLabel(string topic) => topic switch
    {
        "Commute" => "On the train",
        "Work" => "At work",
        "Home" => "Family and home",
        "Food" => "Shops and food",
        "Town" => "Around town",
        "Stories" => "Stories",
        _ => topic
    };

    public static string FormatTime(double seconds) => TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private async Task Speak(string text) => await JSRuntime.InvokeVoidAsync("speakMarathi", text);

    public void Dispose()
    {
        Player.Changed -= OnPlayerChanged;
        Player.FullPlayerVisible = false;
    }
}
