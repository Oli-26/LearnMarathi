@* Masthead shared by the drill pages: back arrow, eyebrow, serif title, Devanagari, blurb. *@
@inject NavigationManager NavigationManager

@if (Compact)
{
    @* One-line header while a quiz is running, so the answers fit on screen. *@
    <div style="padding:4px 20px 0;display:flex;align-items:center;gap:14px;">
        <span @onclick='() => NavigationManager.NavigateTo(BackUrl)' style="cursor:pointer;display:inline-flex;">
            <Icon Name="arrow-left" Size="20" Color="@Theme.Cream" />
        </span>
        <span style="font-family:@Theme.Serif;font-size:22px;color:@Theme.Cream;letter-spacing:-0.5px;">@Title</span>
        <span style="font-family:@Theme.Deva;font-size:17px;color:@Theme.Gold;flex:1;">@Marathi</span>
        <Icon Name="@Glyph" Size="18" Color="@Theme.Gold" />
    </div>
}
else
{
    <div style="padding:4px 20px 0;display:flex;align-items:center;justify-content:space-between;">
        <span @onclick='() => NavigationManager.NavigateTo(BackUrl)' style="cursor:pointer;display:inline-flex;">
            <Icon Name="arrow-left" Size="20" Color="@Theme.Cream" />
        </span>
        <span style="font-family:@Theme.Mono;font-size:10px;letter-spacing:2px;color:@Theme.Muted;text-transform:uppercase;">@Eyebrow</span>
        <Icon Name="@Glyph" Size="18" Color="@Theme.Gold" />
    </div>

    <div style="padding:18px 24px 0;">
        <div style="font-family:@Theme.Serif;font-size:36px;line-height:1;color:@Theme.Cream;letter-spacing:-1px;">@Title</div>
        <div style="font-family:@Theme.Deva;font-size:24px;color:@Theme.Gold;margin-top:6px;">@Marathi</div>
        @if (!string.IsNullOrEmpty(Blurb))
        {
            <div style="font-family:@Theme.Sans;font-size:12px;color:@Theme.Muted;margin-top:14px;line-height:1.6;font-style:italic;max-width:320px;">@Blurb</div>
        }
    </div>

    <div style="margin:24px 24px 0;">
        <Warli Width="100%" Height="14" Color="@Theme.Gold" Opacity="0.6" />
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Marathi { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "";
    [Parameter] public string Blurb { get; set; } = "";
    [Parameter] public string Glyph { get; set; } = "sparkle";
    [Parameter] public string BackUrl { get; set; } = "/";
    [Parameter] public bool Compact { get; set; }
}
