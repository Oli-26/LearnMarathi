@* Line icon set. Usage: <Icon Name="mic" Size="20" Color="@Theme.Gold" /> *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="@Color" stroke-width="@Stroke"
     stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "book":          <path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H19v15.5"/> <path d="M5.5 21H19v-2.5H5.5a1.5 1.5 0 0 0 0 3"/>     break;
        case "words":         <path d="M5 8h14"/> <path d="M5 12h10"/> <path d="M5 16h7"/>                                          break;
        case "chat":          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12Z"/>                                   break;
        case "flame":         <path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4-.5 2 .5 3 1.5 3 0-3 1.5-5 1.5-9z"/>            break;
        case "arrow-right":   <path d="M5 12h14"/> <path d="m13 6 6 6-6 6"/>                                                        break;
        case "arrow-left":    <path d="M19 12H5"/> <path d="m11 18-6-6 6-6"/>                                                       break;
        case "play":          <path d="M6 4.5v15l13-7.5z"/>                                                                          break;
        case "mic":           <rect x="9" y="3" width="6" height="12" rx="3"/> <path d="M5 11a7 7 0 0 0 14 0"/> <path d="M12 18v3"/> break;
        case "pencil":        <path d="m4 20 4-1 11-11-3-3L5 16l-1 4z"/>                                                            break;
        case "target":        <circle cx="12" cy="12" r="9"/> <circle cx="12" cy="12" r="5"/> <circle cx="12" cy="12" r="1.5" fill="@Color" stroke="none"/> break;
        case "speaker":       <path d="M4 9v6h4l5 4V5L8 9H4z"/> <path d="M16 8a5 5 0 0 1 0 8"/>                                     break;
        case "check":         <path d="m5 12 5 5 9-11"/>                                                                              break;
        case "x":             <path d="M6 6l12 12M18 6 6 18"/>                                                                       break;
        case "sparkle":       <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/> break;
        case "menu":          <path d="M4 7h16M4 12h16M4 17h16"/>                                                                    break;
        case "chevron-right": <path d="m9 6 6 6-6 6"/>                                                                                break;
        case "home":          <path d="M4 11 12 4l8 7v9a1 1 0 0 1-1 1h-4v-7h-6v7H5a1 1 0 0 1-1-1z"/>                                 break;
        case "cards":         <rect x="3" y="5" width="13" height="14" rx="2"/> <path d="M8 5v-1a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v14"/> break;
        case "trophy":        <path d="M8 4h8v6a4 4 0 0 1-8 0z"/> <path d="M16 6h3v2a3 3 0 0 1-3 3"/> <path d="M8 6H5v2a3 3 0 0 0 3 3"/> <path d="M10 14h4v3h2v3H8v-3h2z"/> break;
        case "plus":          <path d="M12 5v14M5 12h14"/>                                                                            break;
        case "headphones":    <path d="M3 14a9 9 0 0 1 18 0v4a2 2 0 0 1-2 2h-1v-6h3"/> <path d="M3 14v4a2 2 0 0 0 2 2h1v-6H3"/>      break;
        case "pause":         <path d="M8 5v14"/> <path d="M16 5v14"/>                                                              break;
        case "rewind":        <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/> <path d="M3 3v5h5"/>                                               break;
        case "refresh":       <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/> <path d="M21 3v5h-5"/> <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/> <path d="M3 21v-5h5"/> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "x";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Stroke { get; set; } = 1.6;
}
